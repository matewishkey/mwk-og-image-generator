{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mwk-studio-engine",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "EngineContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "max_instances": 4,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE_CONTAINER", "class_name": "EngineContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EngineContainer"] }],
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },
  "vars": {
    "INSTANCE_NAME": "main-6",
    "R2_ENDPOINT": "https://ef7d622089ca4480c9f6fbf368f66787.r2.cloudflarestorage.com",
    "R2_BUCKET": "mwk-studio",
    "EVENTS_URL": "https://og.matewishkey.com/internal/events"
  }
  // Secrets (wrangler secret put): REPLICATE_API_TOKEN, R2_ACCESS_KEY_ID,
  // R2_SECRET_ACCESS_KEY, SEAM_SECRET
}
