---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { ENV } from '../../lib/runtime';
import { MODELS, PRICES_VERIFIED_ON } from '../../../../src/models.ts';
import { promoThumbs, runPromos, PROMO_PROMPT } from '../../lib/promos';
import { estimateMicros, microsToUsd } from '../../lib/runs';

const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const imageModels = MODELS.filter((m) => m.modality === 'image');
const videoModels = MODELS.filter((m) => m.modality === 'video');

let error = '';
let note = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.getAll('action').at(-1) ?? '') === 'render-promos') {
    try {
      await runPromos(ENV, { teamId: team.id, userId: user.id });
      note = 'Rendering the promo shot on every model — the slow ones take a minute. Reload for the thumbs.';
    } catch (e) {
      error = (e as Error).message;
    }
  }
}

const promos = await promoThumbs(ENV, team.id);
const promoCost = estimateMicros(imageModels.map((m) => m.alias), null, 1, 0);

// Latest observed facts from the nightly sync (append-only; may be empty pre-first-run).
const catalog = await ENV.DB.prepare(
  `SELECT model_id, run_count, model_updated_at FROM model_catalog
    WHERE synced_at = (SELECT max(synced_at) FROM model_catalog)`,
).all<{ model_id: string; run_count: number | null; model_updated_at: string | null }>();
const observed = new Map(catalog.results.map((c) => [c.model_id, c]));
const fmtRuns = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}k` : `${n}`);
---

<Base title="Models" nav="models">
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>Library</p>
    <h1>Models</h1>
    <p class="sub">
      Every slug, field name and price was read off the model's own Replicate page, not
      guessed. Prices last verified <span class="mono">{PRICES_VERIFIED_ON}</span>.
      The thumbs are the same fixed prompt rendered by each model — an honest side-by-side.
    </p>
  </div>

  {error && <p class="flash">{error}</p>}
  {note && <p class="flash">{note}</p>}

  <form method="post" class="promo-bar">
    <input type="hidden" name="action" value="render-promos" />
    <button class="btn small ghost" type="submit" data-running="Rendering promos…"
      title={`"${PROMO_PROMPT}" once per model`}>
      <Icon name="run" />{promos.size ? 'Re-render' : 'Render'} the promo shot on every model · {microsToUsd(promoCost)}
    </button>
  </form>

  <h2>Stills</h2>
  <div class="list">
    {
      imageModels.map((m) => (
        <div class="list-row">
          <span class="list-thumb">
            {promos.has(m.alias) ? (
              <img src={`/img/${promos.get(m.alias)}`} alt={`${m.alias} promo`} loading="lazy" />
            ) : (
              <span class="list-ph">no promo yet</span>
            )}
          </span>
          <span class="list-body">
            <span class="list-name">
              <span class="mono alias">{m.alias}</span> {m.label}
              <span class="mono faint id">{m.id}</span>
            </span>
            <span class="list-meta mono">
              {m.tiers.map((t) => `${t}: $${m.priceUsd[t]}`).join(' · ')}
              {m.typicalSeconds ? ` · ~${m.typicalSeconds}s` : ''}
              {' · '}{m.refStyle === 'none' ? 'no refs' : `${m.refStyle} refs · max ${m.maxRefs}`}
              {m.seedable ? ' · seed' : ''}
              {observed.get(m.id)?.run_count != null ? ` · ${fmtRuns(observed.get(m.id)!.run_count!)} runs` : ''}
            </span>
            {m.goodFor && <span class="list-desc">+ {m.goodFor}</span>}
            {m.weakFor && <span class="list-meta">− {m.weakFor}</span>}
            <span class="list-desc">{m.notes}</span>
          </span>
        </div>
      ))
    }
  </div>

  <h2>Video — phase 2, listed for the record</h2>
  <div class="list">
    {
      videoModels.map((m) => (
        <div class="list-row dimmed">
          <span class="list-body">
            <span class="list-name">
              <span class="mono alias">{m.alias}</span> {m.label}
              <span class="mono faint id">{m.id}</span>
            </span>
            <span class="list-meta mono">
              {m.tiers.map((t) => `${t}: $${m.priceUsd[t]}${m.priceUnit === 'second' ? '/s' : ''}`).join(' · ')}
              {' · '}{m.audio ? 'audio' : 'silent'}
            </span>
            <span class="list-desc">{m.notes}</span>
          </span>
        </div>
      ))
    }
  </div>
</Base>

<style>
  h2 { font-size: 1.25rem; margin: 1.6rem 0 1rem; }
  .promo-bar { margin-bottom: 0.4rem; }
  .list-row.dimmed { opacity: 0.65; }
  .alias { font-weight: 700; color: var(--accent); }
  .id { font-size: 0.72rem; margin-left: 0.5rem; }
  .faint { color: var(--faint); }
</style>
