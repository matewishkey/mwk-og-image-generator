---
import Base from '../layouts/Base.astro';
import { ENV } from '../lib/runtime';
import { microsToUsd } from '../lib/runs';

const env = ENV;
const team = Astro.locals.team;
if (!team) return new Response('No team', { status: 403 });

// Filters live in the query string, so a view survives a paste.
const who = Astro.url.searchParams.get('who') ?? '';
const kind = Astro.url.searchParams.get('kind') ?? '';
const before = Astro.url.searchParams.get('before') ?? '';
const PAGE = 20;

const where: string[] = ['r.team_id = ?1'];
const binds: unknown[] = [team.id];
if (who) {
  where.push(`u.email = ?${binds.length + 1}`);
  binds.push(who);
}
if (kind) {
  where.push(`r.kind = ?${binds.length + 1}`);
  binds.push(kind);
}
if (before) {
  where.push(`r.started_at < ?${binds.length + 1}`);
  binds.push(before);
}

const runs = await env.DB.prepare(
  `SELECT r.id, r.kind, r.status, r.started_at, r.finished_at, r.estimated_micros,
          p.slug AS project_slug, p.name AS project_name, u.email, u.name AS user_name,
          (SELECT count(*) FROM take t WHERE t.run_id = r.id) AS takes,
          (SELECT count(*) FROM take t WHERE t.run_id = r.id AND t.status='succeeded') AS ok,
          coalesce((SELECT sum(c.usd_micros) FROM charge c WHERE c.run_id = r.id), 0) AS actual
     FROM run r JOIN project p ON p.id = r.project_id JOIN user u ON u.id = r.started_by
    WHERE ${where.join(' AND ')}
    ORDER BY r.started_at DESC LIMIT ${PAGE + 1}`,
)
  .bind(...binds)
  .all<{
    id: string; kind: string; status: string; started_at: string; finished_at: string | null;
    estimated_micros: number; project_slug: string; project_name: string; email: string;
    user_name: string | null; takes: number; ok: number; actual: number;
  }>();

const hasMore = runs.results.length > PAGE;
const page = runs.results.slice(0, PAGE);
const nextCursor = hasMore ? page.at(-1)!.started_at : null;

const spendByUser = await env.DB.prepare(
  `SELECT u.email, u.name, coalesce(sum(c.usd_micros), 0) AS spent, count(DISTINCT r.id) AS runs
     FROM charge c JOIN run r ON r.id = c.run_id JOIN user u ON u.id = r.started_by
    WHERE c.team_id = ?1 GROUP BY u.id ORDER BY spent DESC`,
)
  .bind(team.id)
  .all<{ email: string; name: string | null; spent: number; runs: number }>();

const filterQs = (over: Record<string, string>) => {
  const q = new URLSearchParams();
  const merged = { who, kind, ...over };
  for (const [k, v] of Object.entries(merged)) if (v) q.set(k, v);
  const s = q.toString();
  return s ? `?${s}` : '';
};
---

<Base title="History" nav="history">
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{team.name}</p>
    <h1>History</h1>
    <p class="sub">Every run, who started it, what it was estimated at, and what it actually cost.</p>
  </div>

  <div class="spend card">
    {
      spendByUser.results.map((s) => (
        <span class="spend-item">
          <b>{s.name ?? s.email}</b>
          <span class="money">{microsToUsd(s.spent)}</span>
          <span class="mono faint">{s.runs} run{s.runs === 1 ? '' : 's'}</span>
        </span>
      ))
    }
  </div>

  <div class="filters mono">
    <span>kind:</span>
    <a href={filterQs({ kind: '' })} class={!kind ? 'on' : ''}>all</a>
    {['full', 'shot', 'take'].map((k) => (
      <a href={filterQs({ kind: k })} class={kind === k ? 'on' : ''}>{k}</a>
    ))}
    {who && <a href={filterQs({ who: '' })}>clear user: {who} ×</a>}
  </div>

  {
    page.map((r) => (
      <div class="card run-row">
        <span class={`status ${r.status === 'done' ? 'succeeded' : r.status}`}>{r.status}</span>
        {r.project_slug.startsWith('_') ? (
          <b>{r.project_name}</b>
        ) : (
          <a href={`/projects/${r.project_slug}/takes`}><b>{r.project_name}</b></a>
        )}
        <span class="mono faint">{r.kind}</span>
        <span class="mono faint">{r.ok}/{r.takes} takes</span>
        <a class="mono faint" href={filterQs({ who: r.email })}>{r.user_name ?? r.email}</a>
        <span class="money">
          {microsToUsd(r.actual)}
          {r.actual !== r.estimated_micros && <span class="faint"> (est {microsToUsd(r.estimated_micros)})</span>}
        </span>
        <span class="mono faint when">{r.started_at.slice(0, 16).replace('T', ' ')}</span>
      </div>
    ))
  }
  {page.length === 0 && <p class="sub">Nothing matches.</p>}

  {
    nextCursor && (
      <p class="pager">
        <a class="btn ghost small" href={filterQs({ before: nextCursor })}>Older</a>
      </p>
    )
  }
</Base>

<style>
  .spend { display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .spend-item { display: flex; gap: 0.6rem; align-items: baseline; }
  .filters { display: flex; gap: 0.9rem; font-size: 0.78rem; margin-bottom: 1.2rem; color: var(--faint); }
  .filters a { color: var(--mute); }
  .filters a.on { color: var(--accent); font-weight: 700; }
  .run-row { display: flex; gap: 1.1rem; align-items: baseline; flex-wrap: wrap; padding: 0.8rem 1.25rem; }
  .run-row .when { margin-left: auto; }
  .faint { color: var(--faint); }
  .pager { margin-top: 1.4rem; }
</style>
