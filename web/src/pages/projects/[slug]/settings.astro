---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { ENV } from '../../../lib/runtime';
import { loadProject } from '../../../lib/data';
import { MODELS } from '../../../../../src/models.ts';
import { EXTRA_PRESETS } from '../../../../../src/prompt.ts';
import { PROOFS_SLUG } from '../../../lib/proofs';

const env = ENV;
const team = Astro.locals.team;
if (!team) return new Response('No team', { status: 403 });

const slug = Astro.params.slug!;
let bundle = await loadProject(env, team.id, slug);
if (!bundle) return new Response('Not found', { status: 404 });

const styles = await env.DB.prepare(
  `SELECT s.id, s.name, s.description, t.kind AS team_kind FROM style s JOIN team t ON t.id = s.team_id
    WHERE (s.team_id = ?1 OR t.kind = 'house') AND s.archived_at IS NULL
    ORDER BY t.kind DESC, s.name`,
)
  .bind(team.id)
  .all<{ id: string; name: string; description: string; team_kind: string }>();

const imageModels = MODELS.filter((m) => m.modality === 'image');

let error = '';
let note = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const styleId = String(form.get('style') ?? '');
  const models = form.getAll('models').map(String);
  const iterations = Math.max(1, Math.min(8, Number(form.get('iterations') ?? 1)));

  if (!name) error = 'A project needs a name.';
  else if (!models.length) error = 'Pick at least one model.';
  else if (!styles.results.some((s) => s.id === styleId)) error = 'Pick a style.';
  else {
    await env.DB.prepare(
      `UPDATE project SET name=?1, description=?2, default_style_id=?3, models=?4,
         iterations=?5, allow_text=?6, extra=?7, title=?8, kicker=?9, tagline=?10,
         version=version+1, updated_at=?11
       WHERE id=?12`,
    )
      .bind(
        name,
        String(form.get('description') ?? '').trim(),
        styleId,
        JSON.stringify(models),
        iterations,
        form.get('allow_text') ? 1 : 0,
        String(form.get('extra') ?? '').trim() || null,
        String(form.get('title') ?? '').trim() || null,
        String(form.get('kicker') ?? '').trim() || null,
        String(form.get('tagline') ?? '').trim() || null,
        new Date().toISOString(),
        bundle.project.id,
      )
      .run();
    note = 'Saved. The next run uses these settings; past takes are untouched.';
    bundle = (await loadProject(env, team.id, slug))!;
  }
}

const chosenModels = new Set<string>(JSON.parse(bundle.project.models));

// Latest 'face' proof thumb per style — same preview the Shots strip shows.
const proofThumbs = await env.DB.prepare(
  `SELECT style_id, thumb_key FROM (
     SELECT t.style_id, t.thumb_key,
            row_number() OVER (PARTITION BY t.style_id ORDER BY t.created_at DESC) AS rn
       FROM take t
       JOIN run r ON r.id = t.run_id
       JOIN project p ON p.id = r.project_id
       JOIN shot sh ON sh.id = t.shot_id
      WHERE p.team_id = ?1 AND p.slug = ?2
        AND t.status = 'succeeded' AND t.thumb_key IS NOT NULL AND sh.label = 'face'
   ) WHERE rn = 1`,
)
  .bind(team.id, PROOFS_SLUG)
  .all<{ style_id: string; thumb_key: string }>();
const proofThumb = new Map(proofThumbs.results.map((r) => [r.style_id, r.thumb_key]));
---

<Base title={`${bundle.project.name} · settings`} nav="projects" project={{ slug, name: bundle.project.name, active: 'settings' }}>
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{bundle.project.name}</p>
    <h1>Settings</h1>
    <p class="sub">Changing settings never touches what has already run — history stays history.</p>
  </div>


  {error && <p class="flash">{error}</p>}
  {note && <p class="flash">{note}</p>}

  <form method="post" class="settings-form">
    <div class="form-grid">
      <label class="field"><span>Name</span>
        <input type="text" name="name" value={bundle.project.name} required /></label>
      <label class="field"><span>Description</span>
        <input type="text" name="description" value={bundle.project.description} /></label>
    </div>
    <fieldset class="field">
      <span>Default style — a run renders every shot through this (a shot can override it)</span>
      <div class="style-grid">
        {styles.results.map((s) => (
          <label class="style-pick">
            <input type="radio" name="style" value={s.id} checked={s.id === bundle.project.default_style_id} />
            {proofThumb.has(s.id) && <img class="style-pick-img" src={`/img/${proofThumb.get(s.id)}`} alt="" loading="lazy" />}
            <span class="style-head">
              <b>{s.name}</b>
              {s.team_kind === 'house' && <em class="chip">house</em>}
            </span>
            <span class="style-desc">{s.description}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="field">
      <span>Models</span>
      <div class="model-grid">
        {imageModels.map((m) => (
          <label class="model-pick">
            <span class="model-row">
              <input type="checkbox" name="models" value={m.alias} checked={chosenModels.has(m.alias)} />
              <span class="mono">{m.alias}</span>
              <span class="money">${m.priceUsd[m.tiers[0]!]}</span>
              {m.typicalSeconds && <span class="mono secs">~{m.typicalSeconds}s</span>}
            </span>
            {m.goodFor && <span class="model-good">+ {m.goodFor}</span>}
            {m.weakFor && <span class="model-weak">− {m.weakFor}</span>}
          </label>
        ))}
      </div>
    </fieldset>
    <div class="form-grid">
      <label class="field" style="max-width:8rem"><span>Iterations</span>
        <input type="number" name="iterations" value={bundle.project.iterations} min="1" max="8" /></label>
      <label class="field checkbox-field">
        <span>Text in pictures</span>
        <label class="inline-check">
          <input type="checkbox" name="allow_text" checked={bundle.project.allow_text === 1} />
          allow the models to draw text
        </label>
      </label>
    </div>
    <div class="field">
      <span>Extra instruction appended to every prompt (optional) — click a preset to add it</span>
      <div class="preset-chips">
        {EXTRA_PRESETS.map((p) => (
          <button type="button" class="chip-btn" data-preset={p.text} title={p.text}>{p.label}</button>
        ))}
      </div>
      <input type="text" name="extra" id="extra-input" value={bundle.project.extra ?? ''} />
    </div>
    <script is:inline>
      document.querySelectorAll('.chip-btn[data-preset]').forEach((b) =>
        b.addEventListener('click', () => {
          const inp = document.getElementById('extra-input');
          const cur = inp.value.trim();
          inp.value = cur ? `${cur} ${b.dataset.preset}` : b.dataset.preset;
          inp.focus();
        }),
      );
    </script>
    <div class="form-grid">
      <label class="field"><span>Band title — *word* renders red</span>
        <input type="text" name="title" value={bundle.project.title ?? ''} /></label>
      <label class="field"><span>Kicker</span>
        <input type="text" name="kicker" value={bundle.project.kicker ?? ''} /></label>
      <label class="field"><span>Tagline</span>
        <input type="text" name="tagline" value={bundle.project.tagline ?? ''} /></label>
    </div>
    <button class="btn" type="submit"><Icon name="save" />Save settings</button>
  </form>
</Base>

<style>
  .settings-form { max-width: 52rem; }
  .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0 1rem; }
  .form-grid > * { min-width: 0; }
  fieldset { border: 0; }

  .style-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 0.5rem; }
  .style-grid > * { min-width: 0; }
  .style-pick {
    display: grid; gap: 0.3rem; align-content: start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 0.65rem 0.8rem; cursor: pointer;
  }
  .style-pick:has(input:checked) { border-color: var(--accent); }
  .style-pick input { position: absolute; opacity: 0; }
  .style-pick-img {
    width: 100%; height: 4.5rem; object-fit: cover; display: block;
    border-radius: calc(var(--radius) - 2px); border: 1px solid var(--line);
  }
  .style-head { display: flex; align-items: baseline; gap: 0.5rem; }
  .style-pick:has(input:checked) .style-head b { color: var(--accent); }
  .style-desc { color: var(--faint); font-size: 0.8rem; line-height: 1.35; }
  .chip {
    font: 700 0.6rem/1 var(--font-label); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mute); border: 1px solid var(--line); border-radius: 999px;
    padding: 0.15rem 0.45rem; font-style: normal;
  }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 0.5rem; }
  .model-grid > * { min-width: 0; }
  .model-pick {
    display: grid; gap: 0.25rem; align-content: start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 0.55rem 0.8rem; cursor: pointer;
  }
  .model-pick:has(input:checked) { border-color: var(--accent); }
  .model-row { display: flex; align-items: center; gap: 0.5rem; }
  .model-pick .secs { font-weight: 400; color: var(--faint); font-size: 0.75rem; margin-left: auto; }
  .model-good, .model-weak { font-size: 0.78rem; line-height: 1.35; }
  .model-good { color: var(--mute); }
  .model-weak { color: var(--faint); }
  .inline-check { display: flex; gap: 0.5rem; align-items: center; color: var(--mute); font-size: 0.92rem; padding-top: 0.4rem; }

  .preset-chips { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .chip-btn {
    font: 700 0.72rem/1 var(--font-label); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--mute); background: var(--surface); border: 1px solid var(--line);
    border-radius: 999px; padding: 0.35rem 0.7rem; cursor: pointer;
  }
  .chip-btn:hover { color: var(--accent); border-color: var(--accent); }
</style>
