---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { ENV } from '../../../lib/runtime';
import { loadProject } from '../../../lib/data';
import { layoutPanels, LayoutConfigSchema } from '../../../../../src/seam.ts';
import {
  ensurePackLink,
  generateAndRender,
  renderAllFormats,
  renderFromLayout,
  saveTemplate,
} from '../../../lib/design-actions';
import { updateProject } from '../../../lib/projects';
import { resolvePanelTakes } from '../../../lib/previews';

const env = ENV;
const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const slug = Astro.params.slug!;
const bundle = await loadProject(env, team.id, slug);
if (!bundle) return new Response('Not found', { status: 404 });
const project = bundle.project;

// The inventory: the best take per shot (the pick, else the newest draft).
// Designs and previews work from drafts — picking upgrades them, never gates them.
const panels = await resolvePanelTakes(env, project.id);
const pickedCount = panels.length
  ? (
      await env.DB.prepare(
        `SELECT count(*) AS n FROM shot WHERE project_id = ?1 AND deleted_at IS NULL AND picked_take_id IS NOT NULL`,
      )
        .bind(project.id)
        .first<{ n: number }>()
    )?.n ?? 0
  : 0;

// House layouts plus NAMED team templates. Anonymous gen-* layouts from past
// generate runs stay out — their designs live in the versions history, and 70
// near-identical cards is the confusion this gallery exists to kill.
const layouts = await env.DB.prepare(
  `SELECT l.id, l.slug, l.name, l.config FROM layout l JOIN team t ON t.id = l.team_id
    WHERE (l.team_id = ?1 OR t.kind = 'house') AND l.archived_at IS NULL
      AND (t.kind = 'house' OR l.slug NOT LIKE 'gen-%')
    ORDER BY l.name`,
)
  .bind(team.id)
  .all<{ id: string; slug: string; name: string; config: string }>();

const formats = await env.DB.prepare(`SELECT id, slug, name, width, height FROM format ORDER BY rowid`).all<{
  id: string; slug: string; name: string; width: number; height: number;
}>();
const ogFormat = formats.results.find((f) => f.slug === 'og') ?? formats.results[0]!;

const kits = await env.DB.prepare(
  `SELECT b.id, b.name, t.kind FROM brand_kit b JOIN team t ON t.id = b.team_id
    WHERE (b.team_id = ?1 OR t.kind = 'house') AND b.archived_at IS NULL
    ORDER BY t.kind DESC, b.name`,
)
  .bind(team.id)
  .all<{ id: string; name: string; kind: string }>();

const kitConfig = await env.DB.prepare(`SELECT config FROM brand_kit WHERE id = ?1`)
  .bind(project.brand_kit_id)
  .first<{ config: string }>();
// The kit drives the emphasis colour and whether a dark render differs at all.
const kitParsed = (() => {
  try {
    return JSON.parse(kitConfig?.config ?? '') as {
      colors?: { redDeep?: string };
      colorsDark?: Record<string, string>;
    };
  } catch {
    return {};
  }
})();
const accentHex = kitParsed.colors?.redDeep ?? '#f0524a';
const kitHasDark = !!kitParsed.colorsDark && Object.keys(kitParsed.colorsDark).length > 0;

const usable = layouts.results.flatMap((l) => {
  const cfg = LayoutConfigSchema.safeParse(JSON.parse(l.config));
  if (!cfg.success) return [];
  const needs = layoutPanels(cfg.data);
  return needs <= panels.length ? [{ ...l, needs }] : [];
});

const ctx = {
  teamId: team.id,
  userId: user.id,
  project: {
    id: project.id,
    slug,
    brand_kit_id: project.brand_kit_id,
    title: project.title ?? null,
    kicker: project.kicker ?? null,
    tagline: project.tagline ?? null,
  },
};

let error = '';
let genNote = Astro.url.searchParams.get('gen') ?? '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.getAll('action').at(-1) ?? 'render');
  try {
    if (action === 'pack-link') {
      await ensurePackLink(env, project.id);
      return Astro.redirect(`/projects/${slug}/design`);
    } else if (action === 'set-kit') {
      const r = await updateProject(env, team.id, project.id, {
        brandKit: String(form.get('kit') ?? ''),
      });
      if ('error' in r) throw new Error(r.error);
      return Astro.redirect(`/projects/${slug}/design`);
    } else if (action === 'all-formats') {
      await renderAllFormats(env, ctx, String(form.get('design') ?? ''), formats.results);
      return Astro.redirect(`/projects/${slug}/design`);
    } else if (action === 'generate') {
      const formatId = String(form.get('format') ?? ogFormat.id);
      const fmtRow = await env.DB.prepare(
        `SELECT id, slug, name, width, height, safe_w, safe_h FROM format WHERE id = ?1`,
      )
        .bind(formatId)
        .first<{ id: string; slug: string; name: string; width: number; height: number;
                 safe_w: number | null; safe_h: number | null }>();
      const { rendered, dropped } = await generateAndRender(env, ctx, {
        format: fmtRow ?? { ...ogFormat, safe_w: null, safe_h: null },
        brief: String(form.get('brief') ?? '').trim(),
        n: Math.max(2, Math.min(20, Number(form.get('n') ?? 8))),
        kitConfig: kitConfig?.config,
      });
      return Astro.redirect(`/projects/${slug}/design?gen=${rendered}+rendered,+${dropped}+dropped`);
    } else if (action === 'save-template') {
      await saveTemplate(env, ctx, String(form.get('design') ?? ''), String(form.get('name') ?? ''));
      return Astro.redirect(`/projects/${slug}/design?gen=template+saved`);
    } else {
      // 'render' — a gallery card's Use button; the words travel in the same form.
      const layoutId = String(form.get('layout') ?? '');
      if (!layoutId) throw new Error('Click Use on one of the layout cards to render it.');
      const themes = form.getAll('theme').map(String).filter((t) => t === 'light' || t === 'dark') as
        ('light' | 'dark')[];
      const leadId = await renderFromLayout(env, ctx, {
        layoutId,
        formats: [ogFormat],
        themes: themes.length ? themes : ['light'],
        title: String(form.get('title') ?? ''),
        kicker: String(form.get('kicker') ?? ''),
        tagline: String(form.get('tagline') ?? ''),
      });
      return Astro.redirect(`/projects/${slug}/design${leadId ? `?lead=${leadId}` : ''}`);
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

// Archiving a layout retires its designs from this page too — they stay in the
// database (nothing that ran ever disappears) and come back with ?versions=all.
const showAllVersions = Astro.url.searchParams.get('versions') === 'all';
const designs = await env.DB.prepare(
  `SELECT d.id, d.collection_id, d.title, d.tagline, d.kicker, d.r2_key, d.thumb_key, d.width, d.height, d.created_at,
          d.effect, d.theme, l.name AS layout_name, l.team_id AS layout_team_id, l.id AS layout_id,
          f.name AS format_name, f.slug AS format_slug
     FROM design d JOIN layout l ON l.id = d.layout_id JOIN format f ON f.id = d.format_id
    WHERE d.project_id = ?1 AND d.superseded_by_id IS NULL
      AND (l.archived_at IS NULL OR ?2)
    ORDER BY d.created_at DESC`,
)
  .bind(project.id, showAllVersions ? 1 : 0)
  .all<{
    id: string; collection_id: string | null; title: string | null; tagline: string | null;
    kicker: string | null; r2_key: string; thumb_key: string; width: number; height: number;
    created_at: string; effect: string | null; theme: string; layout_name: string;
    layout_team_id: string; layout_id: string; format_name: string; format_slug: string;
  }>();

type DesignRow = (typeof designs.results)[number];
const leadId = Astro.url.searchParams.get('lead');
const lead: DesignRow | undefined =
  designs.results.find((d) => d.id === leadId) ?? designs.results[0];
const versions = designs.results.filter((d) => d.id !== lead?.id);

// The lead's panels, for "download the raw picture without the design".
const leadPanels = lead
  ? (
      await env.DB.prepare(
        `SELECT p.position, p.label, t.art_key FROM design_panel p
           JOIN take t ON t.id = p.take_id
          WHERE p.design_id = ?1 ORDER BY p.position`,
      )
        .bind(lead.id)
        .all<{ position: number; label: string | null; art_key: string | null }>()
    ).results.filter((p) => p.art_key)
  : [];

// Cached previews (possibly stale — the page paints them instantly, then the
// inline script asks the API to refresh each one; a hash match costs nothing).
const previewRows = await env.DB.prepare(
  `SELECT kind, ref_id, r2_key FROM preview WHERE project_id = ?1`,
)
  .bind(project.id)
  .all<{ kind: string; ref_id: string; r2_key: string }>();
const previewKey = new Map(previewRows.results.map((p) => [`${p.kind}:${p.ref_id}`, p.r2_key]));
---

<Base title={`${project.name} · design`} nav="projects" project={{ slug, name: project.name, active: 'design' }}>
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{project.name}</p>
    <h1>Design</h1>
    <p class="sub">
      Every card below is rendered with this project's real pictures, for $0.00 — see it,
      then click the one you want. Fine control lives in
      <a href={`/projects/${slug}/design/editor`}>the editor</a>.
    </p>
  </div>

  <p class="pack-bar">
    {
      (project as unknown as { pack_token: string | null }).pack_token ? (
        <>
          <span class="kicker"><span class="g">/</span>Pack</span>
          <a class="mono" href={`/pack/${(project as unknown as { pack_token: string }).pack_token}`} target="_blank">
            {`${env.PUBLIC_ORIGIN}/pack/${(project as unknown as { pack_token: string }).pack_token.slice(0, 10)}…`}
          </a>
          <span class="faint">— the whole concept behind one link, for the social generator. Add .json for machines.</span>
        </>
      ) : (
        <form method="post">
          <input type="hidden" name="action" value="pack-link" />
          <button class="btn small ghost" type="submit"><Icon name="pack" />Create pack link</button>
        </form>
      )
    }
  </p>

  {error && <p class="flash">{error}</p>}
  {genNote && <p class="flash">{genNote} — every render was $0.00. Keep the good ones, ignore the rest.</p>}

  {
    panels.length === 0 ? (
      <p class="sub">
        No takes yet. Go to <a href={`/projects/${slug}/shots`}>Shots &amp; takes</a> and run the
        shots — the previews here appear as soon as drafts exist.
      </p>
    ) : (
      <>
        {
          bundle.styles.length > 1 && (
            <section class="pv-section">
              <p class="kicker"><span class="g">/</span>The styles, finished — one OG card each, refreshed after every run</p>
              <div class="pv-grid pv-styles">
                {bundle.styles.map((s) => (
                  <figure class="pv-card">
                    <img
                      data-pv-kind="style"
                      data-pv-ref={s.id}
                      src={previewKey.has(`style:${s.id}`) ? `/img/${previewKey.get(`style:${s.id}`)}` : undefined}
                      alt={`${s.name} preview`}
                      loading="lazy"
                    />
                    <figcaption>
                      <b>{s.name}</b>
                      {s.id === project.default_style_id && <em class="chip">primary</em>}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          lead && (
            <section class="lead">
              <figure class="lead-card">
                <a href={`/img/${lead.r2_key}`} target="_blank">
                  <img src={`/img/${lead.r2_key}`} alt={lead.format_name} />
                </a>
                <figcaption>
                  <b>{lead.layout_name}</b>
                  <span class="mono faint">
                    {lead.format_slug} · {lead.width}×{lead.height}{lead.effect ? ` · ${lead.effect}` : ''}
                    {lead.theme === 'dark' ? ' · dark' : ''}
                  </span>
                  <span class="lead-actions">
                    <form method="post">
                      <input type="hidden" name="action" value="all-formats" />
                      <input type="hidden" name="design" value={lead.id} />
                      <button class="btn small" type="submit" data-running="Rendering…"><Icon name="run" />All {formats.results.length} formats · $0.00</button>
                    </form>
                    <a class="btn small ghost" href={`/projects/${slug}/preview?design=${lead.id}`}><Icon name="watch" />Preview</a>
                    <a class="btn small ghost" href={`/projects/${slug}/design/editor?from=${lead.layout_id}&design=${lead.id}`}><Icon name="edit" />Open in editor</a>
                    <a class="btn small ghost" href={`/img/${lead.r2_key}`} download={`${slug}-${lead.format_slug}.png`}><Icon name="download" />Download</a>
                    {leadPanels.map((p) => (
                      <a class="btn small ghost" href={`/img/${p.art_key}`} download={`${slug}-${p.label ?? `panel-${p.position}`}-raw.png`}>
                        <Icon name="download" />Raw {leadPanels.length > 1 ? p.label ?? p.position : 'picture'}
                      </a>
                    ))}
                  </span>
                  {lead.layout_team_id === team.id && (
                    <form method="post" class="save-template">
                      <input type="hidden" name="action" value="save-template" />
                      <input type="hidden" name="design" value={lead.id} />
                      <input type="text" name="name" placeholder="save this layout as a template…" />
                      <button class="btn small ghost" type="submit"><Icon name="template" />Save</button>
                    </form>
                  )}
                </figcaption>
              </figure>
            </section>
          )
        }

        <form method="post" class="design-form card">
          <p class="inventory mono">
            Working with {panels.length} image{panels.length === 1 ? '' : 's'}
            ({pickedCount} picked{pickedCount < panels.length ? ', the rest are the newest drafts — picking on the shots page upgrades them' : ''})
            — {panels.map((p) => p.label ?? `shot ${p.position}`).join(' · ')}
          </p>
          <div class="opts-row">
            <label class="field">
              <span>Brand kit</span>
              <select id="kit-select" name="kit">
                {kits.results.map((k) => (
                  <option value={k.id} selected={k.id === project.brand_kit_id}>
                    {k.name}{k.kind === 'house' ? ' (house)' : ''}
                  </option>
                ))}
              </select>
            </label>
            <label class="field">
              <span>Title — *word* renders in the kit's accent <i class="accent-swatch" style={`background:${accentHex}`} title={accentHex}></i></span>
              <input type="text" name="title" value={project.title ?? ''} /></label>
            <label class="field"><span>Kicker (label above) — usually not with a tagline</span>
              <input type="text" name="kicker" value={project.kicker ?? ''} /></label>
            <label class="field"><span>Tagline (sentence below)</span>
              <input type="text" name="tagline" value={project.tagline ?? ''} /></label>
            <fieldset class="field theme-field">
              <span>Theme{kitHasDark ? '' : ' — this kit has no dark palette yet; dark renders identical'}</span>
              <label class="inline-check"><input type="checkbox" name="theme" value="light" checked /> light</label>
              <label class="inline-check"><input type="checkbox" name="theme" value="dark" /> dark</label>
            </fieldset>
          </div>
          <script is:inline>
            // Changing the kit re-renders every preview — a page round-trip, kept honest.
            document.getElementById('kit-select')?.addEventListener('change', (e) => {
              const f = e.target.form;
              const a = document.createElement('input');
              a.type = 'hidden'; a.name = 'action'; a.value = 'set-kit';
              f.appendChild(a);
              f.requestSubmit();
            });
          </script>

          <p class="kicker gallery-kicker"><span class="g">/</span>The layouts, with your pictures — click Use to make it a real card (OG format; more from the lead)</p>
          <div class="pv-grid pv-layouts">
            {usable.map((l) => (
              <figure class="pv-card">
                <img
                  data-pv-kind="layout"
                  data-pv-ref={l.id}
                  src={previewKey.has(`layout:${l.id}`) ? `/img/${previewKey.get(`layout:${l.id}`)}` : undefined}
                  alt={`${l.name} preview`}
                  loading="lazy"
                />
                <figcaption>
                  <b>{l.name}</b>
                  <span class="mono faint">{l.needs} image{l.needs === 1 ? '' : 's'}</span>
                  <button class="btn small" type="submit" name="layout" value={l.id} data-running="Rendering…">
                    <Icon name="run" />Use · $0.00
                  </button>
                </figcaption>
              </figure>
            ))}
          </div>
          {usable.length === 0 && (
            <p class="sub">No layout fits yet — every layout needs at least one image per panel.</p>
          )}
        </form>

        <form method="post" class="design-form card generate-form">
          <input type="hidden" name="action" value="generate" />
          <p class="inventory mono">Or let the model propose arrangements — it writes configs, the renderer draws them.</p>
          <div class="form-grid">
            <label class="field">
              <span>Direction (optional) — <button type="button" class="linkish" id="brief-minimal">minimal</button> fills a quiet brief</span>
              <input type="text" name="brief" id="brief-input" placeholder="e.g. make the launch the hero, keep it calm" />
            </label>
            <label class="field" style="max-width:10rem">
              <span>How many</span>
              <select name="n">
                <option value="4">4</option>
                <option value="8" selected>8</option>
                <option value="12">12</option>
                <option value="20">20</option>
              </select>
            </label>
            <label class="field">
              <span>Format</span>
              <select name="format">
                {formats.results.map((f) => (
                  <option value={f.id}>{f.name} · {f.width}×{f.height}</option>
                ))}
              </select>
            </label>
          </div>
          <button class="btn ghost" type="submit" data-running="Designing — twenty seconds or so…"><Icon name="template" />Generate layouts · under a cent</button>
          <script is:inline>
            document.getElementById('brief-minimal')?.addEventListener('click', () => {
              const b = document.getElementById('brief-input');
              b.value = 'minimal and quiet: one image or two at most, generous empty space, no shapes, at most one small text layer';
              b.focus();
            });
          </script>
        </form>

        {
          versions.length > 0 && (
            <section class="versions">
              <p class="kicker">
                <span class="g">/</span>Versions — click one to lead
                {showAllVersions ? (
                  <a href="?">hide retired</a>
                ) : (
                  <a href="?versions=all">show retired too</a>
                )}
              </p>
              <div class="designs-grid">
                {versions.map((d) => (
                  <figure class="design-card">
                    <a href={`/projects/${slug}/design?lead=${d.id}`}>
                      <img src={`/img/${d.thumb_key}`} alt={d.format_name} loading="lazy" />
                    </a>
                    <figcaption>
                      <span>{d.layout_name}</span>
                      <span class="mono faint">{d.format_slug}{d.theme === 'dark' ? ' · dark' : ''}</span>
                      <a class="btn small ghost" href={`/img/${d.r2_key}`} download={`${slug}-${d.format_slug}.png`} title="Download"><Icon name="download" />PNG</a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        <script is:inline define:vars={{ slug }}>
          // Refresh every preview card: fresh ones answer instantly from the hash
          // check; stale/missing ones render once, then the image swaps in.
          (() => {
            const imgs = [...document.querySelectorAll('img[data-pv-kind]')];
            const queue = [...imgs];
            imgs.forEach((i) => { if (!i.getAttribute('src')) i.closest('.pv-card')?.classList.add('pv-loading'); });
            let active = 0;
            const MAX = 3;
            const pump = () => {
              while (active < MAX && queue.length) {
                const img = queue.shift();
                active++;
                fetch(`/api/projects/${slug}/previews`, {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ kind: img.dataset.pvKind, ref: img.dataset.pvRef }),
                })
                  .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
                  .then((d) => {
                    if (img.getAttribute('src') !== d.url) img.src = d.url;
                    img.closest('.pv-card')?.classList.remove('pv-loading', 'pv-failed');
                  })
                  .catch(() => img.closest('.pv-card')?.classList.add('pv-failed'))
                  .finally(() => { active--; pump(); });
              }
            };
            pump();
          })();
        </script>
      </>
    )
  }
</Base>

<style>
  .design-form { margin-bottom: 2rem; }
  .inventory { color: var(--faint); font-size: 0.78rem; margin-bottom: 1rem; }
  .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0 1rem; }
  .form-grid > * { min-width: 0; }
  .pack-bar { display: flex; gap: 0.8rem; align-items: baseline; margin-bottom: 1.4rem; flex-wrap: wrap; font-size: 0.85rem; }
  .pack-bar .faint { color: var(--faint); }
  .lead { margin-bottom: 2rem; }
  .lead-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; max-width: 64rem; }
  .lead-card img { display: block; width: 100%; height: auto; }
  .lead-card figcaption { display: flex; align-items: center; gap: 0.9rem; padding: 0.7rem 1rem; flex-wrap: wrap; }
  .lead-actions { margin-left: auto; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .save-template { display: flex; gap: 0.4rem; width: 100%; margin-top: 0.3rem; }
  .save-template input[type=text] { font-size: 0.82rem; padding: 0.35rem 0.55rem; max-width: 22rem; }
  fieldset { border: 0; }
  .inline-check { display: inline-flex; gap: 0.4rem; align-items: center; margin-right: 1.2rem; color: var(--mute); font-size: 0.9rem; }
  .accent-swatch {
    display: inline-block; width: 0.85em; height: 0.85em; border-radius: 3px;
    vertical-align: -0.1em; border: 1px solid var(--line);
  }

  .pv-section { margin-bottom: 2rem; }
  .pv-section .kicker, .gallery-kicker { margin-bottom: 0.8rem; }
  .pv-grid { display: grid; gap: 0.9rem; }
  .pv-grid > * { min-width: 0; }
  .pv-styles { grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .pv-layouts { grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .pv-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin: 0; }
  .pv-card img { display: block; width: 100%; aspect-ratio: 1200 / 630; height: auto; object-fit: cover; background: var(--surface-2); }
  .pv-card figcaption { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.7rem; font-size: 0.8rem; flex-wrap: wrap; }
  .pv-card figcaption .btn { margin-left: auto; }
  .pv-loading img { opacity: 0.35; }
  .pv-loading::after { content: 'rendering…'; display: block; padding: 0 0.7rem 0.5rem; color: var(--faint); font-size: 0.72rem; }
  .pv-failed::after { content: 'preview unavailable'; display: block; padding: 0 0.7rem 0.5rem; color: var(--faint); font-size: 0.72rem; }

  .opts-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0 1rem; margin-bottom: 0.6rem; }
  .opts-row > * { min-width: 0; }
  .theme-field { padding-top: 0.2rem; }

  .versions .kicker { margin-bottom: 0.8rem; }
  .designs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.9rem; }
  .designs-grid > * { min-width: 0; }
