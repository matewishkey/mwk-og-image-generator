---
import Base from '../../../layouts/Base.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import { ENV } from '../../../lib/runtime';
import { loadProject } from '../../../lib/data';
import { createCollection, createDesign } from '../../../lib/design';
import { ARCHETYPE_PANELS, LayoutConfigSchema } from '../../../../../src/seam.ts';
import { generateLayouts } from '../../../lib/generate';
import { ulid } from '../../../lib/ulid';

const env = ENV;
const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const slug = Astro.params.slug!;
const bundle = await loadProject(env, team.id, slug);
if (!bundle) return new Response('Not found', { status: 404 });

// The inventory: this project's picks, in shot order, with their art.
const picks = await env.DB.prepare(
  `SELECT sh.id AS shot_id, sh.position, sh.label, t.id AS take_id, t.art_key, t.model_alias
     FROM shot sh JOIN take t ON t.id = sh.picked_take_id
    WHERE sh.project_id = ?1 AND sh.deleted_at IS NULL AND t.art_key IS NOT NULL
    ORDER BY sh.position`,
)
  .bind(bundle.project.id)
  .all<{ shot_id: string; position: number; label: string | null; take_id: string; art_key: string; model_alias: string }>();

const layouts = await env.DB.prepare(
  `SELECT l.id, l.slug, l.name, l.config FROM layout l JOIN team t ON t.id = l.team_id
    WHERE (l.team_id = ?1 OR t.kind = 'house') AND l.archived_at IS NULL ORDER BY l.name`,
)
  .bind(team.id)
  .all<{ id: string; slug: string; name: string; config: string }>();

const formats = await env.DB.prepare(`SELECT id, slug, name, width, height FROM format ORDER BY rowid`).all<{
  id: string;
  slug: string;
  name: string;
  width: number;
  height: number;
}>();

const usable = layouts.results.filter((l) => {
  const cfg = LayoutConfigSchema.safeParse(JSON.parse(l.config));
  return cfg.success && ARCHETYPE_PANELS[cfg.data.archetype] <= picks.results.length;
});

let error = '';
let genNote = Astro.url.searchParams.get('gen') ?? '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'render');

  if (action === 'pack-link') {
    // One unguessable token per project; creating it twice keeps the first.
    const token = crypto.randomUUID().replaceAll('-', '') + crypto.randomUUID().replaceAll('-', '');
    await env.DB.prepare(
      `UPDATE project SET pack_token = coalesce(pack_token, ?1) WHERE id = ?2`,
    )
      .bind(token, bundle.project.id)
      .run();
    return Astro.redirect(`/projects/${slug}/design`);
  } else if (action === 'all-formats') {
    // Promote one design: same layout, same words, every format — a collection.
    const src = await env.DB.prepare(
      `SELECT layout_id, title, kicker, tagline FROM design WHERE id = ?1 AND team_id = ?2 AND project_id = ?3`,
    )
      .bind(String(form.get('design') ?? ''), team.id, bundle.project.id)
      .first<{ layout_id: string; title: string | null; kicker: string | null; tagline: string | null }>();
    if (src && picks.results.length > 0) {
      try {
        const collectionId = ulid();
        await env.DB.prepare(
          `INSERT INTO collection (id, team_id, project_id, name, created_by, created_at)
           VALUES (?1, ?2, ?3, ?4, ?5, ?6)`,
        )
          .bind(collectionId, team.id, bundle.project.id, null, user.id, new Date().toISOString())
          .run();
        await createCollection(env, {
          teamId: team.id,
          userId: user.id,
          projectId: bundle.project.id,
          layoutId: src.layout_id,
          brandKitId: bundle.project.brand_kit_id,
          title: src.title ?? undefined,
          kicker: src.kicker ?? undefined,
          tagline: src.tagline ?? undefined,
          collectionId,
          formats: formats.results,
          panels: picks.results.map((pk) => ({
            takeId: pk.take_id,
            artKey: pk.art_key,
            label: pk.label ?? undefined,
          })),
        });
        return Astro.redirect(`/projects/${slug}/design`);
      } catch (e) {
        error = (e as Error).message;
      }
    }
  } else if (action === 'generate' && picks.results.length > 0) {
    try {
      const formatId = String(form.get('format') ?? 'fmt_og');
      const format = formats.results.find((f) => f.id === formatId) ?? formats.results[0]!;
      const fmtRow = await env.DB.prepare(`SELECT name, width, height, safe_w, safe_h FROM format WHERE id = ?1`)
        .bind(format.id)
        .first<{ name: string; width: number; height: number; safe_w: number | null; safe_h: number | null }>();
      const n = Math.max(2, Math.min(20, Number(form.get('n') ?? 8)));
      const brief = String(form.get('brief') ?? '').trim();
      const { layouts: generated, dropped } = await generateLayouts(
        env,
        {
          panels: picks.results.map((pk) => ({
            label: pk.label ?? `shot ${pk.position}`,
            width: null,
            height: null,
          })),
          format: fmtRow!,
        },
        brief,
        n,
      );
      const nowIso = new Date().toISOString();
      let rendered = 0;
      for (const g of generated) {
        const layoutId = ulid();
        await env.DB.prepare(
          `INSERT INTO layout (id, team_id, slug, name, config, brief, generated_by, created_at, updated_at)
           VALUES (?1, ?2, ?3, ?4, ?5, ?6, 'openai/gpt-5.6-terra', ?7, ?7)`,
        )
          .bind(layoutId, team.id, `gen-${layoutId.slice(-8).toLowerCase()}`, g.name,
                JSON.stringify(g.config), brief || null, nowIso)
          .run();
        try {
          await createDesign(env, {
            teamId: team.id,
            userId: user.id,
            projectId: bundle.project.id,
            layoutId,
            formatId: format.id,
            brandKitId: bundle.project.brand_kit_id,
            title: bundle.project.title ?? undefined,
            kicker: bundle.project.kicker ?? undefined,
            tagline: bundle.project.tagline ?? undefined,
            panels: picks.results.map((pk) => ({
              takeId: pk.take_id,
              artKey: pk.art_key,
              label: pk.label ?? undefined,
            })),
          });
          rendered++;
        } catch {
          /* a config the renderer rejects is dropped, not shown */
        }
      }
      return Astro.redirect(`/projects/${slug}/design?gen=${rendered}+rendered,+${dropped + (generated.length - rendered)}+dropped`);
    } catch (e) {
      error = (e as Error).message;
    }
  } else
  try {
    const formatChoice = String(form.get('format') ?? '');
    const text = {
      title: String(form.get('title') ?? '').trim() || undefined,
      kicker: String(form.get('kicker') ?? '').trim() || undefined,
      tagline: String(form.get('tagline') ?? '').trim() || undefined,
    };
    const base = {
      teamId: team.id,
      userId: user.id,
      projectId: bundle.project.id,
      layoutId: String(form.get('layout') ?? ''),
      brandKitId: bundle.project.brand_kit_id,
      ...text,
      panels: picks.results.map((p) => ({
        takeId: p.take_id,
        artKey: p.art_key,
        label: p.label ?? undefined,
      })),
    };
    if (formatChoice === 'all') {
      // One design across every format: a Collection. Renders are $0.00, so the
      // answer to "which format?" is "all of them" — download the ones you need.
      const collectionId = ulid();
      await env.DB.prepare(
        `INSERT INTO collection (id, team_id, project_id, name, created_by, created_at)
         VALUES (?1, ?2, ?3, ?4, ?5, ?6)`,
      )
        .bind(collectionId, team.id, bundle.project.id,
              usable.find((l) => l.id === base.layoutId)?.name ?? null,
              user.id, new Date().toISOString())
        .run();
      const { rendered, failed } = await createCollection(env, {
        ...base,
        collectionId,
        formats: formats.results,
      });
      return Astro.redirect(
        `/projects/${slug}/design${failed ? `?gen=${rendered}+of+${rendered + failed}+rendered` : ''}`,
      );
    }
    await createDesign(env, { ...base, formatId: formatChoice });
    return Astro.redirect(`/projects/${slug}/design`);
  } catch (e) {
    error = (e as Error).message;
  }
}

const designs = await env.DB.prepare(
  `SELECT d.id, d.collection_id, d.title, d.tagline, d.kicker, d.r2_key, d.thumb_key, d.width, d.height, d.created_at,
          l.name AS layout_name, f.name AS format_name, f.slug AS format_slug
     FROM design d JOIN layout l ON l.id = d.layout_id JOIN format f ON f.id = d.format_id
    WHERE d.project_id = ?1 AND d.superseded_by_id IS NULL
    ORDER BY d.created_at DESC`,
)
  .bind(bundle.project.id)
  .all<{
    id: string;
    collection_id: string | null;
    title: string | null;
    tagline: string | null;
    kicker: string | null;
    r2_key: string;
    thumb_key: string;
    width: number;
    height: number;
    created_at: string;
    layout_name: string;
    format_name: string;
    format_slug: string;
  }>();

type DesignRow = (typeof designs.results)[number];
const leadId = Astro.url.searchParams.get('lead');
const lead: DesignRow | undefined =
  designs.results.find((d) => d.id === leadId) ?? designs.results[0];
const versions = designs.results.filter((d) => d.id !== lead?.id);
---

<Base title={`${bundle.project.name} · design`} nav="projects">
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{bundle.project.name}</p>
    <h1>Design</h1>
    <p class="sub">
      Picks + a layout + a format = a finished card, rendered for $0.00. Changing the
      words or the layout just makes another one — iterate freely.
    </p>
  </div>

  <ProjectTabs slug={slug} active="design" />

  <p class="pack-bar">
    {
      (bundle.project as unknown as { pack_token: string | null }).pack_token ? (
        <>
          <span class="kicker"><span class="g">/</span>Pack</span>
          <a class="mono" href={`/pack/${(bundle.project as unknown as { pack_token: string }).pack_token}`} target="_blank">
            {`${env.PUBLIC_ORIGIN}/pack/${(bundle.project as unknown as { pack_token: string }).pack_token.slice(0, 10)}…`}
          </a>
          <span class="faint">— the whole concept behind one link, for the social generator. Add .json for machines.</span>
        </>
      ) : (
        <form method="post">
          <input type="hidden" name="action" value="pack-link" />
          <button class="btn small ghost" type="submit">Create pack link</button>
        </form>
      )
    }
  </p>

  {error && <p class="flash">{error}</p>}
  {genNote && <p class="flash">{genNote} — every render was $0.00. Keep the good ones, ignore the rest.</p>}

  {
    lead && (
      <section class="lead">
        <figure class="lead-card">
          <a href={`/img/${lead.r2_key}`} target="_blank">
            <img src={`/img/${lead.r2_key}`} alt={lead.format_name} />
          </a>
          <figcaption>
            <b>{lead.layout_name}</b>
            <span class="mono faint">{lead.format_slug} · {lead.width}×{lead.height}</span>
            <span class="lead-actions">
              <form method="post">
                <input type="hidden" name="action" value="all-formats" />
                <input type="hidden" name="design" value={lead.id} />
                <button class="btn small" type="submit">All {formats.results.length} formats · $0.00</button>
              </form>
              <a class="btn small ghost" href={`/projects/${slug}/preview?design=${lead.id}`}>Preview</a>
              <a class="btn small ghost" href={`/img/${lead.r2_key}`} download={`${slug}-${lead.format_slug}.png`}>Download</a>
            </span>
          </figcaption>
        </figure>
      </section>
    )
  }

  {
    picks.results.length === 0 ? (
      <p class="sub">
        No picks yet. Go to <a href={`/projects/${slug}/takes`}>Takes</a> and pick the take that
        should represent each shot.
      </p>
    ) : (
      <form method="post" class="design-form card">
        <p class="inventory mono">
          Inventory: {picks.results.length} pick{picks.results.length === 1 ? '' : 's'} —{' '}
          {picks.results.map((p) => p.label ?? `shot ${p.position}`).join(' · ')}
        </p>
        <div class="form-grid">
          <label class="field">
            <span>Layout</span>
            <select name="layout" required>
              {usable.map((l) => (
                <option value={l.id}>{l.name}</option>
              ))}
            </select>
          </label>
          <label class="field">
            <span>Format</span>
            <select name="format" required>
              <option value="all" selected>Every format — one collection, {formats.results.length} designs</option>
              {formats.results.map((f) => (
                <option value={f.id}>{f.name} · {f.width}×{f.height}</option>
              ))}
            </select>
          </label>
        </div>
        <div class="form-grid">
          <label class="field"><span>Title — *word* renders red</span>
            <input type="text" name="title" value={bundle.project.title ?? ''} /></label>
          <label class="field"><span>Kicker (label above) — usually not with a tagline</span>
            <input type="text" name="kicker" value={bundle.project.kicker ?? ''} /></label>
          <label class="field"><span>Tagline (sentence below)</span>
            <input type="text" name="tagline" value={bundle.project.tagline ?? ''} /></label>
        </div>
        <button class="btn" type="submit">Render design · $0.00</button>
      </form>
    )
  }

  {
    picks.results.length > 0 && (
      <form method="post" class="design-form card generate-form">
        <input type="hidden" name="action" value="generate" />
        <p class="inventory mono">Or let the model propose arrangements — it writes configs, the renderer draws them.</p>
        <div class="form-grid">
          <label class="field">
            <span>Direction (optional)</span>
            <input type="text" name="brief" placeholder="e.g. make the launch the hero, keep it calm" />
          </label>
          <label class="field" style="max-width:10rem">
            <span>How many</span>
            <select name="n">
              <option value="4">4</option>
              <option value="8" selected>8</option>
              <option value="12">12</option>
              <option value="20">20</option>
            </select>
          </label>
          <label class="field">
            <span>Format</span>
            <select name="format">
              {formats.results.map((f) => (
                <option value={f.id}>{f.name} · {f.width}×{f.height}</option>
              ))}
            </select>
          </label>
        </div>
        <button class="btn ghost" type="submit">Generate layouts · under a cent</button>
      </form>
    )
  }

  {
    versions.length > 0 && (
      <section class="versions">
        <p class="kicker"><span class="g">/</span>Versions — click one to lead</p>
        <div class="designs-grid">
          {versions.map((d) => (
            <figure class="design-card">
              <a href={`/projects/${slug}/design?lead=${d.id}`}>
                <img src={`/img/${d.thumb_key}`} alt={d.format_name} loading="lazy" />
              </a>
              <figcaption>
                <span>{d.layout_name}</span>
                <span class="mono faint">{d.format_slug}</span>
                <a class="btn small ghost" href={`/img/${d.r2_key}`} download={`${slug}-${d.format_slug}.png`}>↓</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .design-form { margin-bottom: 2rem; }
  .inventory { color: var(--faint); font-size: 0.78rem; margin-bottom: 1rem; }
  .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0 1rem; }
  .form-grid > * { min-width: 0; }
  .pack-bar { display: flex; gap: 0.8rem; align-items: baseline; margin-bottom: 1.4rem; flex-wrap: wrap; font-size: 0.85rem; }
  .pack-bar .faint { color: var(--faint); }
  .lead { margin-bottom: 2rem; }
  .lead-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; max-width: 64rem; }
  .lead-card img { display: block; width: 100%; height: auto; }
  .lead-card figcaption { display: flex; align-items: center; gap: 0.9rem; padding: 0.7rem 1rem; flex-wrap: wrap; }
  .lead-actions { margin-left: auto; display: flex; gap: 0.5rem; align-items: center; }
  .versions .kicker { margin-bottom: 0.8rem; }
  .designs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.9rem; }
  .designs-grid > * { min-width: 0; }
  .design-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .design-card img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.7rem; font-size: 0.8rem; flex-wrap: wrap; }
  .faint { color: var(--faint); }
  figcaption .btn { margin-left: auto; }
</style>
