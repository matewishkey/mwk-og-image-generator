---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { ENV } from '../../../lib/runtime';
import { loadProject } from '../../../lib/data';
import {
  consumedPanels,
  hasExplicitPanels,
  LayoutConfigSchema,
} from '../../../../../src/seam.ts';
import {
  ensurePackLink,
  generateAndRender,
  renderAllFormats,
  renderFromLayout,
  saveTemplate,
} from '../../../lib/design-actions';
import { resolvePanelTakes, scopeInventory } from '../../../lib/previews';

const env = ENV;
const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const slug = Astro.params.slug!;
const bundle = await loadProject(env, team.id, slug);
if (!bundle) return new Response('Not found', { status: 404 });
const project = bundle.project;

// ── The scope: which shot / style / theme this whole page works in.
// Lives in the query string so a scope IS a pasteable, bookmarkable package.
const q = Astro.url.searchParams;
const scopeShot = /^\d+$/.test(q.get('shot') ?? '') ? Number(q.get('shot')) : null;
const scopeStyle = bundle.styles.find((s) => s.slug === q.get('style')) ?? null;
const scopeTheme = q.get('theme') === 'dark' ? ('dark' as const) : ('light' as const);
/** Rebuild the query string with one key changed; null deletes the key. */
const scoped = (patch: Record<string, string | null>) => {
  const p = new URLSearchParams(q);
  p.delete('lead');
  for (const [k, v] of Object.entries(patch)) (v === null ? p.delete(k) : p.set(k, v));
  const s = p.toString();
  return `/projects/${slug}/design${s ? `?${s}` : ''}`;
};
const scopeQs = (() => {
  const p = new URLSearchParams();
  if (scopeShot != null) p.set('shot', String(scopeShot));
  if (scopeStyle) p.set('style', scopeStyle.slug);
  if (scopeTheme === 'dark') p.set('theme', 'dark');
  return p.toString();
})();

// The inventory: one slot per shot, position-ordered and index-STABLE — hidden
// shots and style gaps become null slots, they never shift panel indexes.
const panels = await resolvePanelTakes(env, project.id, scopeStyle?.id);
const usableSlots = panels.filter((p) => !p.hidden && p.take_id).length;
const pickedCount = panels.length
  ? (
      await env.DB.prepare(
        `SELECT count(*) AS n FROM shot WHERE project_id = ?1 AND deleted_at IS NULL AND picked_take_id IS NOT NULL`,
      )
        .bind(project.id)
        .first<{ n: number }>()
    )?.n ?? 0
  : 0;

// House layouts plus NAMED team templates. Anonymous gen-* layouts stay out.
const layouts = await env.DB.prepare(
  `SELECT l.id, l.slug, l.name, l.config, t.kind AS team_kind FROM layout l JOIN team t ON t.id = l.team_id
    WHERE (l.team_id = ?1 OR t.kind = 'house') AND l.archived_at IS NULL
      AND (t.kind = 'house' OR l.slug NOT LIKE 'gen-%')
    ORDER BY l.name`,
)
  .bind(team.id)
  .all<{ id: string; slug: string; name: string; config: string; team_kind: string }>();

const formats = await env.DB.prepare(`SELECT id, slug, name, width, height FROM format ORDER BY rowid`).all<{
  id: string; slug: string; name: string; width: number; height: number;
}>();
const ogFormat = formats.results.find((f) => f.slug === 'og') ?? formats.results[0]!;

const kitRow = await env.DB.prepare(`SELECT name, config FROM brand_kit WHERE id = ?1`)
  .bind(project.brand_kit_id)
  .first<{ name: string; config: string }>();
const kitParsed = (() => {
  try {
    return JSON.parse(kitRow?.config ?? '') as { colorsDark?: Record<string, string> };
  } catch {
    return {};
  }
})();
const kitHasDark = !!kitParsed.colorsDark && Object.keys(kitParsed.colorsDark).length > 0;

// Which templates fit the current scope, and which shots each one uses.
const shotIndexOfScope = scopeShot != null ? panels.findIndex((p) => p.position === scopeShot) : -1;
const usable = layouts.results.flatMap((l) => {
  const parsed = LayoutConfigSchema.safeParse(JSON.parse(l.config));
  if (!parsed.success) return [];
  const cfg = parsed.data;
  const consumed = consumedPanels(cfg);
  const explicit = hasExplicitPanels(cfg);
  const inv = scopeInventory(cfg, panels, scopeShot ?? undefined);
  const fits = consumed.every((i) => inv[i] != null);
  if (!fits) return [];
  // Scoped to a shot: explicitly-wired templates only show when they use it.
  if (scopeShot != null && explicit && shotIndexOfScope >= 0 && !consumed.includes(shotIndexOfScope))
    return [];
  const uses = consumed
    .map((i) => (explicit || scopeShot == null ? panels[i] : inv[i]))
    .filter(Boolean)
    .map((p) => p!.label ?? `shot ${p!.position}`);
  return [{ ...l, needs: consumed.length, uses: [...new Set(uses)] }];
});
const teamTemplates = usable.filter((l) => l.team_kind !== 'house');
const houseLayouts = usable.filter((l) => l.team_kind === 'house');

const ctx = {
  teamId: team.id,
  userId: user.id,
  project: {
    id: project.id,
    slug,
    brand_kit_id: project.brand_kit_id,
    title: project.title ?? null,
    kicker: project.kicker ?? null,
    tagline: project.tagline ?? null,
  },
};

let error = '';
let genNote = q.get('gen') ?? '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.getAll('action').at(-1) ?? 'render');
  const back = `/projects/${slug}/design${scopeQs ? `?${scopeQs}` : ''}`;
  try {
    if (action === 'pack-link') {
      await ensurePackLink(env, project.id);
      return Astro.redirect(back);
    } else if (action === 'hide-shot' || action === 'unhide-shot') {
      const pos = Number(form.get('position'));
      await env.DB.prepare(
        `UPDATE shot SET hidden_at = ?1 WHERE project_id = ?2 AND position = ?3 AND deleted_at IS NULL`,
      )
        .bind(action === 'hide-shot' ? new Date().toISOString() : null, project.id, pos)
        .run();
      return Astro.redirect(back);
    } else if (action === 'all-formats') {
      await renderAllFormats(env, ctx, String(form.get('design') ?? ''), formats.results);
      return Astro.redirect(back);
    } else if (action === 'generate') {
      const formatId = String(form.get('format') ?? ogFormat.id);
      const fmtRow = await env.DB.prepare(
        `SELECT id, slug, name, width, height, safe_w, safe_h FROM format WHERE id = ?1`,
      )
        .bind(formatId)
        .first<{ id: string; slug: string; name: string; width: number; height: number;
                 safe_w: number | null; safe_h: number | null }>();
      const kitConfig = kitRow?.config;
      const { rendered, dropped } = await generateAndRender(env, ctx, {
        format: fmtRow ?? { ...ogFormat, safe_w: null, safe_h: null },
        brief: String(form.get('brief') ?? '').trim(),
        n: Math.max(2, Math.min(20, Number(form.get('n') ?? 8))),
        kitConfig,
      });
      return Astro.redirect(`${back}${back.includes('?') ? '&' : '?'}gen=${rendered}+rendered,+${dropped}+dropped`);
    } else if (action === 'save-template') {
      await saveTemplate(env, ctx, String(form.get('design') ?? ''), String(form.get('name') ?? ''));
      return Astro.redirect(`${back}${back.includes('?') ? '&' : '?'}gen=template+saved`);
    } else {
      // 'render' — a gallery card's Use button. Words come from the project
      // (Settings is the one place to edit them); scope rides the render.
      const layoutId = String(form.get('layout') ?? '');
      if (!layoutId) throw new Error('Click Use on one of the layout cards to render it.');
      const leadNew = await renderFromLayout(env, ctx, {
        layoutId,
        formats: [ogFormat],
        themes: [scopeTheme],
        styleId: scopeStyle?.id,
        shotPosition: scopeShot ?? undefined,
        title: project.title ?? undefined,
        kicker: project.kicker ?? undefined,
        tagline: project.tagline ?? undefined,
      });
      return Astro.redirect(`${back}${back.includes('?') ? '&' : '?'}lead=${leadNew}`);
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

// Archived-layout designs stay retired unless asked for; superseded rows never show.
const showAllVersions = q.get('versions') === 'all';
const designs = await env.DB.prepare(
  `SELECT d.id, d.collection_id, d.title, d.tagline, d.kicker, d.r2_key, d.thumb_key, d.width, d.height, d.created_at,
          d.effect, d.theme, l.name AS layout_name, l.team_id AS layout_team_id, l.id AS layout_id,
          f.name AS format_name, f.slug AS format_slug
     FROM design d JOIN layout l ON l.id = d.layout_id JOIN format f ON f.id = d.format_id
    WHERE d.project_id = ?1 AND d.superseded_by_id IS NULL
      AND (l.archived_at IS NULL OR ?2)
    ORDER BY d.created_at DESC`,
)
  .bind(project.id, showAllVersions ? 1 : 0)
  .all<{
    id: string; collection_id: string | null; title: string | null; tagline: string | null;
    kicker: string | null; r2_key: string; thumb_key: string; width: number; height: number;
    created_at: string; effect: string | null; theme: string; layout_name: string;
    layout_team_id: string; layout_id: string; format_name: string; format_slug: string;
  }>();

type DesignRow = (typeof designs.results)[number];
const leadId = q.get('lead');
const lead: DesignRow | undefined =
  designs.results.find((d) => d.id === leadId) ?? designs.results[0];
const versions = designs.results.filter((d) => d.id !== lead?.id);
// The lead's set: its collection siblings, as one-click format switches.
const leadSiblings = lead?.collection_id
  ? designs.results.filter((d) => d.collection_id === lead.collection_id && d.id !== lead.id)
  : [];
// Versions grouped: one entry per collection (newest-first), solos as themselves.
const versionGroups: { key: string; label: string; theme: string; rows: DesignRow[] }[] = [];
{
  const seen = new Set<string>();
  for (const d of versions) {
    const key = d.collection_id ?? `solo-${d.id}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const rows = d.collection_id ? versions.filter((v) => v.collection_id === d.collection_id) : [d];
    versionGroups.push({ key, label: d.layout_name, theme: d.theme, rows });
  }
}

const leadPanels = lead
  ? (
      await env.DB.prepare(
        `SELECT p.position, p.label, t.art_key FROM design_panel p
           JOIN take t ON t.id = p.take_id
          WHERE p.design_id = ?1 ORDER BY p.position`,
      )
        .bind(lead.id)
        .all<{ position: number; label: string | null; art_key: string | null }>()
    ).results.filter((p) => p.art_key)
  : [];

// Cached previews, keyed exactly like the refresh API composes its refs.
const scopeSuffix =
  (scopeStyle ? `@s-${scopeStyle.slug}` : '') +
  (scopeShot != null ? `@p-${scopeShot}` : '') +
  (scopeTheme === 'dark' ? '@t-dark' : '');
const previewRows = await env.DB.prepare(
  `SELECT kind, ref_id, r2_key FROM preview WHERE project_id = ?1`,
)
  .bind(project.id)
  .all<{ kind: string; ref_id: string; r2_key: string }>();
const previewKey = new Map(previewRows.results.map((p) => [`${p.kind}:${p.ref_id}`, p.r2_key]));
---

<Base title={`${project.name} · design`} nav="projects" project={{ slug, name: project.name, active: 'design' }}>
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{project.name}</p>
    <h1>Design</h1>
    <p class="sub">
      Pick a picture and a style below — every template renders with YOUR choice, free.
      Fine control lives in <a href={`/projects/${slug}/design/editor`}>the editor</a>;
      words and kit live in <a href={`/projects/${slug}/settings`}>settings</a>.
    </p>
  </div>

  {error && <p class="flash">{error}</p>}
  {genNote && <p class="flash">{genNote} — every render was $0.00. Keep the good ones, ignore the rest.</p>}

  {
    panels.length === 0 ? (
      <p class="sub">
        No takes yet. Go to <a href={`/projects/${slug}/shots`}>Shots &amp; takes</a> and run the
        shots — the previews here appear as soon as drafts exist.
      </p>
    ) : (
      <>
        <section class="scope card">
          <p class="kicker"><span class="g">/</span>Working with — the picture and look every card below uses</p>
          <div class="scope-row">
            <span class="scope-label mono">picture</span>
            <a class:list={['chip', { on: scopeShot == null }]} href={scoped({ shot: null })}>all shots</a>
            {panels.map((p) => (
              <span class:list={['shot-chip', { hidden: !!p.hidden }]}>
                <a
                  class:list={['chip', 'chip-img', { on: scopeShot === p.position }]}
                  href={scoped({ shot: String(p.position) })}
                  title={p.hidden ? 'hidden — not feeding designs' : undefined}
                >
                  {p.art_thumb_key && <img src={`/img/${p.art_thumb_key}`} alt="" loading="lazy" />}
                  {p.label ?? `shot ${p.position}`}
                </a>
                <form method="post" class="hide-form">
                  <input type="hidden" name="action" value={p.hidden ? 'unhide-shot' : 'hide-shot'} />
                  <input type="hidden" name="position" value={p.position} />
                  <button class="eye" type="submit" title={p.hidden ? 'unhide this shot' : 'hide this shot from designs'}>
                    <Icon name={p.hidden ? 'watch' : 'hide'} />{p.hidden ? 'unhide' : 'hide'}
                  </button>
                </form>
              </span>
            ))}
          </div>
          {bundle.styles.length > 1 && (
            <div class="scope-row">
              <span class="scope-label mono">style</span>
              <a class:list={['chip', { on: !scopeStyle }]} href={scoped({ style: null })}>any style</a>
              {bundle.styles.map((s) => (
                <a class:list={['chip', { on: scopeStyle?.id === s.id }]} href={scoped({ style: s.slug })}>
                  {s.name}{s.id === project.default_style_id ? ' ·  primary' : ''}
                </a>
              ))}
            </div>
          )}
          {kitHasDark && (
            <div class="scope-row">
              <span class="scope-label mono">theme</span>
              <a class:list={['chip', { on: scopeTheme === 'light' }]} href={scoped({ theme: null })}>light</a>
              <a class:list={['chip', { on: scopeTheme === 'dark' }]} href={scoped({ theme: 'dark' })}>dark</a>
            </div>
          )}
          <p class="scope-note mono">
            {scopeShot != null || scopeStyle
              ? `Scoped: ${scopeShot != null ? (panels.find((p) => p.position === scopeShot)?.label ?? `shot ${scopeShot}`) : 'all shots'} · ${scopeStyle?.name ?? 'any style'} — ${usable.length} template${usable.length === 1 ? '' : 's'} fit. This URL is the package: bookmark it, switch by clicking.`
              : `${usableSlots} of ${panels.length} shots feeding designs (${pickedCount} picked) — scope to one to work on it.`}
          </p>
        </section>

        {
          lead && (
            <section class="lead">
              <p class="kicker"><span class="g">/</span>Current card{leadSiblings.length ? ' — one click switches format' : ''}</p>
              <figure class="lead-card">
                <a href={`/img/${lead.r2_key}`} target="_blank">
                  <img src={`/img/${lead.r2_key}`} alt={lead.format_name} />
                </a>
                <figcaption>
                  <b>{lead.layout_name}</b>
                  <span class="mono faint">
                    {lead.format_slug} · {lead.width}×{lead.height}{lead.effect ? ` · ${lead.effect}` : ''}
                    {lead.theme === 'dark' ? ' · dark' : ''}
                  </span>
                  {leadSiblings.length > 0 && (
                    <span class="fmt-chips">
                      {leadSiblings.map((d) => (
                        <a class="chip" href={scoped({}) + (scoped({}).includes('?') ? '&' : '?') + `lead=${d.id}`}>{d.format_slug}</a>
                      ))}
                    </span>
                  )}
                  <span class="lead-actions">
                    <form method="post">
                      <input type="hidden" name="action" value="all-formats" />
                      <input type="hidden" name="design" value={lead.id} />
                      <button class="btn small" type="submit" data-running="Rendering…"><Icon name="run" />All {formats.results.length} formats</button>
                    </form>
                    <a class="btn small ghost" href={`/projects/${slug}/preview?design=${lead.id}`}><Icon name="watch" />Preview</a>
                    <a class="btn small ghost" href={`/projects/${slug}/design/editor?from=${lead.layout_id}&design=${lead.id}`}><Icon name="edit" />Open in editor</a>
                    <a class="btn small ghost" href={`/img/${lead.r2_key}`} download={`${slug}-${lead.format_slug}.png`}><Icon name="download" />Download</a>
                    {leadPanels.map((p) => (
                      <a class="btn small ghost" href={`/img/${p.art_key}`} download={`${slug}-${p.label ?? `panel-${p.position}`}-raw.png`}>
                        <Icon name="download" />Raw {leadPanels.length > 1 ? p.label ?? p.position : 'picture'}
                      </a>
                    ))}
                  </span>
                  {lead.layout_team_id === team.id && (
                    <form method="post" class="save-template">
                      <input type="hidden" name="action" value="save-template" />
                      <input type="hidden" name="design" value={lead.id} />
                      <input type="text" name="name" placeholder="save this layout as a template…" />
                      <button class="btn small ghost" type="submit"><Icon name="template" />Save</button>
                    </form>
                  )}
                </figcaption>
              </figure>
            </section>
          )
        }

        {[
          { title: 'Your templates', items: teamTemplates },
          { title: 'House layouts', items: houseLayouts },
        ].map(
          (group) =>
            group.items.length > 0 && (
              <section class="gallery">
                <p class="kicker">
                  <span class="g">/</span>{group.title} — with your picture; click Use to make a real card, free
                </p>
                <div class="pv-grid pv-layouts">
                  {group.items.map((l) => (
                    <figure class="pv-card">
                      <img
                        data-pv-kind="layout"
                        data-pv-ref={l.id}
                        src={previewKey.has(`layout:${l.id}${scopeSuffix}`) ? `/img/${previewKey.get(`layout:${l.id}${scopeSuffix}`)}` : undefined}
                        alt={`${l.name} preview`}
                        loading="lazy"
                      />
                      <figcaption>
                        <b>{l.name}</b>
                        <span class="mono faint">uses {l.uses.join(' · ') || `${l.needs} image${l.needs === 1 ? '' : 's'}`}</span>
                        <form method="post" class="use-form">
                          <input type="hidden" name="action" value="render" />
                          <button class="btn small" type="submit" name="layout" value={l.id} data-running="Rendering…">
                            <Icon name="run" />Use
                          </button>
                        </form>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            ),
        )}
        {usable.length === 0 && (
          <p class="sub">No template fits this scope — unhide a shot or clear the scope above.</p>
        )}

        <form method="post" class="design-form card generate-form">
          <input type="hidden" name="action" value="generate" />
          <p class="inventory mono">Or let the model propose arrangements — it writes configs, the renderer draws them.</p>
          <div class="form-grid">
            <label class="field">
              <span>Direction (optional) — <button type="button" class="linkish" id="brief-minimal">minimal</button> fills a quiet brief</span>
              <input type="text" name="brief" id="brief-input" placeholder="e.g. make the launch the hero, keep it calm" />
            </label>
            <label class="field" style="max-width:10rem">
              <span>How many</span>
              <select name="n">
                <option value="4">4</option>
                <option value="8" selected>8</option>
                <option value="12">12</option>
                <option value="20">20</option>
              </select>
            </label>
            <label class="field">
              <span>Format</span>
              <select name="format">
                {formats.results.map((f) => (
                  <option value={f.id}>{f.name} · {f.width}×{f.height}</option>
                ))}
              </select>
            </label>
          </div>
          <button class="btn ghost" type="submit" data-running="Designing — twenty seconds or so…"><Icon name="template" />Generate layouts · under a cent</button>
          <script is:inline>
            document.getElementById('brief-minimal')?.addEventListener('click', () => {
              const b = document.getElementById('brief-input');
              b.value = 'minimal and quiet: one image or two at most, generous empty space, no shapes, at most one small text layer';
              b.focus();
            });
          </script>
        </form>

        {
          versionGroups.length > 0 && (
            <section class="versions">
              <p class="kicker">
                <span class="g">/</span>Versions — grouped by render set; click one to lead
                {showAllVersions ? (
                  <a href={scoped({ versions: null })}>hide retired</a>
                ) : (
                  <a href={scoped({ versions: 'all' })}>show retired too</a>
                )}
              </p>
              <div class="vgroups">
                {versionGroups.map((g) => (
                  <figure class="vgroup design-card">
                    <a href={scoped({}) + (scoped({}).includes('?') ? '&' : '?') + `lead=${g.rows[0]!.id}`}>
                      <img src={`/img/${g.rows[0]!.thumb_key}`} alt={g.label} loading="lazy" />
                    </a>
                    <figcaption>
                      <span>{g.label}</span>
                      <span class="mono faint">{g.theme === 'dark' ? 'dark · ' : ''}{g.rows.length === 1 ? g.rows[0]!.format_slug : `${g.rows.length} formats`}</span>
                      {g.rows.length > 1 && (
                        <span class="fmt-chips">
                          {g.rows.map((d) => (
                            <a class="chip" href={scoped({}) + (scoped({}).includes('?') ? '&' : '?') + `lead=${d.id}`}>{d.format_slug}</a>
                          ))}
                        </span>
                      )}
                      <a class="btn small ghost" href={`/img/${g.rows[0]!.r2_key}`} download={`${slug}-${g.rows[0]!.format_slug}.png`} title="Download"><Icon name="download" />PNG</a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        <p class="pack-bar">
          {
            (project as unknown as { pack_token: string | null }).pack_token ? (
              <>
                <span class="kicker"><span class="g">/</span>Pack</span>
                <a class="mono" href={`/pack/${(project as unknown as { pack_token: string }).pack_token}`} target="_blank">
                  {`${env.PUBLIC_ORIGIN}/pack/${(project as unknown as { pack_token: string }).pack_token.slice(0, 10)}…`}
                </a>
                <span class="faint">— the whole concept behind one link, for the social generator. Add .json for machines.</span>
              </>
            ) : (
              <form method="post">
                <input type="hidden" name="action" value="pack-link" />
                <button class="btn small ghost" type="submit"><Icon name="pack" />Create pack link</button>
              </form>
            )
          }
          <span class="faint">Kit: {kitRow?.name ?? '?'} · words: “{project.title ?? '—'}” — <a href={`/projects/${slug}/settings`}>change in settings</a></span>
        </p>

        <script is:inline define:vars={{ slug, scopeStyle: scopeStyle?.slug ?? null, scopeShot, scopeTheme }}>
          // Refresh every preview card under the CURRENT scope. Cached images
          // paint instantly but wear a "checking" shimmer until the API
          // confirms they're fresh for this exact scope.
          (() => {
            const imgs = [...document.querySelectorAll('img[data-pv-kind]')];
            const queue = [...imgs];
            imgs.forEach((i) => {
              i.closest('.pv-card')?.classList.add(i.getAttribute('src') ? 'pv-checking' : 'pv-loading');
            });
            let active = 0;
            const MAX = 3;
            const pump = () => {
              while (active < MAX && queue.length) {
                const img = queue.shift();
                active++;
                const body = { kind: img.dataset.pvKind, ref: img.dataset.pvRef };
                if (img.dataset.pvKind === 'layout') {
                  if (scopeStyle) body.style = scopeStyle;
                  if (scopeShot != null) body.shot = scopeShot;
                  if (scopeTheme === 'dark') body.theme = 'dark';
                }
                fetch(`/api/projects/${slug}/previews`, {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify(body),
                })
                  .then((r) => (r.ok ? r.json() : r.json().then((e) => Promise.reject(new Error(e?.error ?? r.status)))))
                  .then((d) => {
                    if (img.getAttribute('src') !== d.url) img.src = d.url;
                    img.closest('.pv-card')?.classList.remove('pv-loading', 'pv-checking', 'pv-failed');
                  })
                  .catch((e) => {
                    const card = img.closest('.pv-card');
                    card?.classList.remove('pv-loading', 'pv-checking');
                    card?.classList.add('pv-failed');
                    if (card) card.title = String(e.message ?? 'preview unavailable');
                  })
                  .finally(() => { active--; pump(); });
              }
            };
            pump();
          })();
        </script>
      </>
    )
  }
</Base>

