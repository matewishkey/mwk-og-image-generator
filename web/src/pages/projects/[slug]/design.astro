---
/**
 * The DESIGN page does ONE thing since round 7: assemble. Pick a TEMPLATE,
 * see the current REVISION (template + slot assignments + words), swap any
 * slot's picture, tweak the words, Render. Browsing finished renders lives on
 * /results; fine geometry control lives in the editor; shot visibility lives
 * on /shots. NOTHING auto-renders here — the engine runs only on intent.
 *
 * URL state: ?template=<layoutId>&revision=<designId>&theme=dark — pasteable,
 * bookmarkable. Old ?style/?shot params are ignored; ?lead redirects into the
 * revision model.
 */
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { ENV } from '../../../lib/runtime';
import { loadProject } from '../../../lib/data';
import {
  consumedPanels,
  layoutPanels,
  selectPanels,
  LayoutConfigSchema,
  type LayoutConfig,
} from '../../../../../src/seam.ts';
import {
  generateAndRender,
  renderFromLayout,
  rerenderDesign,
  reviseDesign,
  saveTemplate,
  setPanel,
} from '../../../lib/design-actions';
import { resolvePanelTakes, scopeInventory } from '../../../lib/previews';

const env = ENV;
const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const slug = Astro.params.slug!;
const bundle = await loadProject(env, team.id, slug);
if (!bundle) return new Response('Not found', { status: 404 });
const project = bundle.project;

const q = Astro.url.searchParams;

// Legacy bookmark: ?lead=<designId> becomes ?template=&revision=.
if (q.get('lead')) {
  const d = await env.DB.prepare(
    `SELECT id, layout_id FROM design WHERE id = ?1 AND project_id = ?2`,
  )
    .bind(q.get('lead'), project.id)
    .first<{ id: string; layout_id: string }>();
  return Astro.redirect(
    d ? `/projects/${slug}/design?template=${d.layout_id}&revision=${d.id}` : `/projects/${slug}/design`,
  );
}

const scopeTheme = q.get('theme') === 'dark' ? ('dark' as const) : ('light' as const);
/** This page's URL with one key changed; null deletes the key. Legacy keys drop. */
const tUrl = (patch: Record<string, string | null>) => {
  const p = new URLSearchParams();
  for (const k of ['template', 'revision', 'theme'] as const) {
    const v = q.get(k);
    if (v) p.set(k, v);
  }
  for (const [k, v] of Object.entries(patch)) (v === null ? p.delete(k) : p.set(k, v));
  const s = p.toString();
  return `/projects/${slug}/design${s ? `?${s}` : ''}`;
};

// The slot-stable inventory (style plays no part here — round 7).
const panels = await resolvePanelTakes(env, project.id);
const usableSlots = panels.filter((p) => !p.hidden && p.take_id).length;

// House layouts plus NAMED team templates; anonymous gen-* stay out.
const layouts = await env.DB.prepare(
  `SELECT l.id, l.slug, l.name, l.config, t.kind AS team_kind FROM layout l JOIN team t ON t.id = l.team_id
    WHERE (l.team_id = ?1 OR t.kind = 'house') AND l.archived_at IS NULL
      AND (t.kind = 'house' OR l.slug NOT LIKE 'gen-%')
    ORDER BY l.name`,
)
  .bind(team.id)
  .all<{ id: string; slug: string; name: string; config: string; team_kind: string }>();

const formats = await env.DB.prepare(`SELECT id, slug, name, width, height FROM format ORDER BY rowid`).all<{
  id: string; slug: string; name: string; width: number; height: number;
}>();
const ogFormat = formats.results.find((f) => f.slug === 'og') ?? formats.results[0]!;

const kitRow = await env.DB.prepare(`SELECT name, config FROM brand_kit WHERE id = ?1`)
  .bind(project.brand_kit_id)
  .first<{ name: string; config: string }>();
const kitHasDark = (() => {
  try {
    const c = JSON.parse(kitRow?.config ?? '') as { colorsDark?: Record<string, string> };
    return !!c.colorsDark && Object.keys(c.colorsDark).length > 0;
  } catch {
    return false;
  }
})();

// Templates with meta: parsed config, slot count, does-it-fit, freshest thumb.
const thumbRows = await env.DB.prepare(
  `SELECT layout_id, thumb_key, max(created_at) AS created_at FROM design
    WHERE project_id = ?1 GROUP BY layout_id`,
)
  .bind(project.id)
  .all<{ layout_id: string; thumb_key: string }>();
const thumbOf = new Map(thumbRows.results.map((r) => [r.layout_id, r.thumb_key]));

interface Template {
  id: string; slug: string; name: string; team_kind: string;
  cfg: LayoutConfig; needs: number; fits: boolean; uses: string[]; thumb?: string;
}
const templates: Template[] = layouts.results.flatMap((l) => {
  const parsed = LayoutConfigSchema.safeParse(JSON.parse(l.config));
  if (!parsed.success) return [];
  const cfg = parsed.data;
  const consumed = consumedPanels(cfg);
  const inv = scopeInventory(cfg, panels);
  const fits = consumed.every((i) => inv[i] != null);
  const uses = [...new Set(consumed.map((i) => panels[i]).filter(Boolean).map((p) => p!.label ?? `shot ${p!.position}`))];
  return [{
    id: l.id, slug: l.slug, name: l.name, team_kind: l.team_kind,
    cfg, needs: layoutPanels(cfg), fits, uses, thumb: thumbOf.get(l.id),
  }];
});
const teamTemplates = templates.filter((t) => t.team_kind !== 'house');
const houseTemplates = templates.filter((t) => t.team_kind === 'house');

const ctx = {
  teamId: team.id,
  userId: user.id,
  project: {
    id: project.id,
    slug,
    brand_kit_id: project.brand_kit_id,
    title: project.title ?? null,
    kicker: project.kicker ?? null,
    tagline: project.tagline ?? null,
  },
};

let error = '';
const genNote = q.get('gen') ?? '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.getAll('action').at(-1) ?? '');
  const word = (k: string) => {
    const v = form.get(k);
    return v == null ? undefined : String(v);
  };
  /** Land on the new revision WITH its template selected — the POST may have
   *  arrived on a URL that never carried ?template. */
  const revisionUrl = async (designId: string) => {
    const d = await env.DB.prepare(`SELECT layout_id FROM design WHERE id = ?1`)
      .bind(designId)
      .first<{ layout_id: string }>();
    return tUrl({ template: d?.layout_id ?? null, revision: designId });
  };
  try {
    if (action === 'render') {
      // First render of a template: resolve slots from the project inventory.
      const layoutId = String(form.get('template') ?? '');
      const id = await renderFromLayout(env, ctx, {
        layoutId,
        formats: [ogFormat],
        themes: [scopeTheme],
        title: word('title'),
        kicker: word('kicker'),
        tagline: word('tagline'),
      });
      return Astro.redirect(tUrl({ template: layoutId, revision: id }));
    } else if (action === 'rerender') {
      // Replay the revision's OWN slots; words/theme ride as overrides.
      const designId = String(form.get('design') ?? '');
      const id = await rerenderDesign(env, ctx, {
        designId,
        overrides: {
          title: word('title'),
          kicker: word('kicker'),
          tagline: word('tagline'),
          theme: scopeTheme,
        },
      });
      return Astro.redirect(await revisionUrl(id));
    } else if (action === 'set-panel') {
      const id = await setPanel(env, ctx, {
        designId: String(form.get('design') ?? ''),
        position: Number(form.get('position')),
        takeId: String(form.get('take') ?? ''),
      });
      return Astro.redirect(await revisionUrl(id));
    } else if (action === 'revise') {
      const id = await reviseDesign(env, ctx, {
        designId: String(form.get('design') ?? ''),
        instruction: String(form.get('instruction') ?? ''),
      });
      return Astro.redirect(await revisionUrl(id));
    } else if (action === 'save-template') {
      await saveTemplate(env, ctx, String(form.get('design') ?? ''), String(form.get('name') ?? ''));
      return Astro.redirect(tUrl({ gen: 'template saved' }));
    } else if (action === 'generate') {
      const formatId = String(form.get('format') ?? ogFormat.id);
      const fmtRow = await env.DB.prepare(
        `SELECT id, slug, name, width, height, safe_w, safe_h FROM format WHERE id = ?1`,
      )
        .bind(formatId)
        .first<{ id: string; slug: string; name: string; width: number; height: number;
                 safe_w: number | null; safe_h: number | null }>();
      const { rendered, dropped } = await generateAndRender(env, ctx, {
        format: fmtRow ?? { ...ogFormat, safe_w: null, safe_h: null },
        brief: String(form.get('brief') ?? '').trim(),
        n: Math.max(2, Math.min(20, Number(form.get('n') ?? 20))),
        kitConfig: kitRow?.config,
      });
      return Astro.redirect(tUrl({ gen: `${rendered} rendered, ${dropped} dropped` }));
    }
    throw new Error('unknown action');
  } catch (e) {
    error = (e as Error).message;
  }
}

// ── The current template: ?template, else the newest design's layout.
let currentTemplate: Template | undefined = templates.find((t) => t.id === q.get('template'));
if (!currentTemplate && !q.get('template')) {
  // Default to the newest design whose template is actually LISTED above
  // (anonymous gen-* and archived layouts aren't; walking past them keeps the
  // workspace populated instead of blank).
  const recent = await env.DB.prepare(
    `SELECT layout_id, max(created_at) AS newest FROM design
      WHERE project_id = ?1 AND superseded_by_id IS NULL
      GROUP BY layout_id ORDER BY newest DESC LIMIT 40`,
  )
    .bind(project.id)
    .all<{ layout_id: string }>();
  for (const r of recent.results) {
    currentTemplate = templates.find((t) => t.id === r.layout_id);
    if (currentTemplate) break;
  }
}

// ── Revisions of that template (non-superseded, newest first).
interface RevisionRow {
  id: string; r2_key: string; thumb_key: string; title: string | null; kicker: string | null;
  tagline: string | null; theme: string; created_at: string; format_slug: string;
  format_name: string; width: number; height: number; collection_id: string | null;
}
const revisions = currentTemplate
  ? (
      await env.DB.prepare(
        `SELECT d.id, d.r2_key, d.thumb_key, d.title, d.kicker, d.tagline, d.theme, d.created_at,
                d.collection_id, d.width, d.height, f.slug AS format_slug, f.name AS format_name
           FROM design d JOIN format f ON f.id = d.format_id
          WHERE d.project_id = ?1 AND d.layout_id = ?2 AND d.superseded_by_id IS NULL
          ORDER BY d.created_at DESC`,
      )
        .bind(project.id, currentTemplate.id)
        .all<RevisionRow>()
    ).results
  : [];
const currentRevision: RevisionRow | undefined =
  revisions.find((r) => r.id === q.get('revision')) ??
  revisions.find((r) => r.theme === scopeTheme) ??
  revisions[0];

// ── The revision's slots (its OWN design_panel rows), for the strip + swaps.
interface SlotRow {
  position: number; label: string | null; take_id: string | null;
  thumb: string | null; art_key: string | null; shot_position: number | null;
}
const slots: SlotRow[] = currentRevision
  ? (
      await env.DB.prepare(
        `SELECT p.position, p.label, p.take_id,
                coalesce(t.art_thumb_key, t.art_key, r.r2_key) AS thumb,
                coalesce(t.art_key, r.r2_key) AS art_key,
                sh.position AS shot_position
           FROM design_panel p
           LEFT JOIN take t ON t.id = p.take_id
           LEFT JOIN shot sh ON sh.id = t.shot_id
           LEFT JOIN reference r ON r.id = p.reference_id
          WHERE p.design_id = ?1 ORDER BY p.position`,
      )
        .bind(currentRevision.id)
        .all<SlotRow>()
    ).results
  : [];

// ── No revision yet: a $0.00 client-side schematic of what Render would use.
let prospective: { thumb: string | null; label: string }[] = [];
let prospectiveErr = '';
if (currentTemplate && !currentRevision) {
  try {
    prospective = selectPanels(currentTemplate.cfg, scopeInventory(currentTemplate.cfg, panels)).map((p) => ({
      thumb: p.art_thumb_key ?? p.art_key,
      label: p.label ?? `shot ${p.position}`,
    }));
  } catch (e) {
    prospectiveErr = (e as Error).message;
  }
}
/** Approximate cell rects for the schematic — freeform cells carry their own
 *  fractions; archetypes get a rough sketch (the render is the truth). */
const schematicRects = (cfg: LayoutConfig): { x: number; y: number; w: number; h: number }[] => {
  if (cfg.cells?.length) return cfg.cells.map((c) => ({ x: c.x, y: c.y, w: c.w, h: c.h }));
  const s = cfg.split ?? 0.5;
  switch (cfg.archetype) {
    case 'hero': return [{ x: 0, y: 0, w: 1, h: 1 }];
    case 'diptych': return [{ x: 0, y: 0, w: s, h: 1 }, { x: s, y: 0, w: 1 - s, h: 1 }];
    case 'stack': return [{ x: 0, y: 0, w: 1, h: s }, { x: 0, y: s, w: 1, h: 1 - s }];
    case 'triptych': return [0, 1, 2].map((i) => ({ x: i / 3, y: 0, w: 1 / 3, h: 1 }));
    case 'mosaic': {
      const f = cfg.split ?? 0.62;
      return [{ x: 0, y: 0, w: f, h: 1 }, { x: f, y: 0, w: 1 - f, h: 0.5 }, { x: f, y: 0.5, w: 1 - f, h: 0.5 }];
    }
    case 'quad': return [0, 1, 2, 3].map((i) => ({ x: (i % 2) / 2, y: Math.floor(i / 2) / 2, w: 0.5, h: 0.5 }));
    case 'filmstrip': return [0, 1, 2, 3].map((i) => ({ x: i / 4, y: 0, w: 0.25, h: 1 }));
    default: return [];
  }
};
const schematic = currentTemplate && !currentRevision && prospective.length
  ? schematicRects(currentTemplate.cfg).map((r, i) => ({ ...r, ...prospective[i]! }))
  : [];

// ── Every succeeded take, grouped by shot — the swap picker's inventory.
const swapTakes = currentRevision
  ? (
      await env.DB.prepare(
        `SELECT t.id, coalesce(t.art_thumb_key, t.art_key) AS thumb, t.model_alias, t.iteration,
                sh.position AS shot_position, sh.label AS shot_label,
                (t.id = sh.picked_take_id) AS picked, s.name AS style_name
           FROM take t JOIN shot sh ON sh.id = t.shot_id JOIN style s ON s.id = t.style_id
          WHERE sh.project_id = ?1 AND sh.deleted_at IS NULL
            AND t.status = 'succeeded' AND t.art_key IS NOT NULL
          ORDER BY sh.position, t.created_at DESC`,
      )
        .bind(project.id)
        .all<{ id: string; thumb: string | null; model_alias: string; iteration: number;
               shot_position: number; shot_label: string | null; picked: number; style_name: string }>()
    ).results
  : [];
const swapGroups = (() => {
  const g = new Map<number, { label: string; takes: typeof swapTakes }>();
  for (const t of swapTakes) {
    if (!g.has(t.shot_position)) g.set(t.shot_position, { label: t.shot_label ?? `shot ${t.shot_position}`, takes: [] });
    g.get(t.shot_position)!.takes.push(t);
  }
  return [...g.entries()].map(([position, v]) => ({ position, ...v }));
})();

const words = {
  title: currentRevision?.title ?? project.title ?? '',
  kicker: currentRevision?.kicker ?? project.kicker ?? '',
  tagline: currentRevision?.tagline ?? project.tagline ?? '',
};
---

<Base title={`${project.name} · design`} nav="projects" project={{ slug, name: project.name, active: 'design' }}>
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{project.name}</p>
    <h1>Design</h1>
    <p class="sub">
      Pick a template, place your pictures, say the words — then Render.
      Finished cards live on <a href={`/projects/${slug}/results`}>Results</a>;
      fine control in <a href={`/projects/${slug}/design/editor`}>the editor</a>.
    </p>
  </div>

  {error && <p class="flash">{error}</p>}
  {genNote && <p class="flash">{genNote} — every render was $0.00. Keep the good ones, ignore the rest.</p>}

  {
    panels.length === 0 ? (
      <p class="sub">
        No takes yet. Go to <a href={`/projects/${slug}/shots`}>Shots &amp; takes</a> and run the
        shots — as soon as pictures exist, the templates here can place them.
      </p>
    ) : (
      <>
        <section class="tpl">
          <p class="kicker">
            <span class="g">/</span>Template — the design itself: slots, words, colors. Pick one; nothing renders until you say so.
          </p>
          {[
            { title: 'Your templates', items: teamTemplates },
            { title: 'House', items: houseTemplates },
          ].map(
            (group) =>
              group.items.length > 0 && (
                <div class="tpl-group">
                  <p class="tpl-head mono">{group.title}</p>
                  <div class="tpl-grid">
                    {group.items.map((t) => (
                      <a
                        class:list={['tpl-card', { on: currentTemplate?.id === t.id, unfit: !t.fits }]}
                        href={tUrl({ template: t.id, revision: null })}
                      >
                        {t.thumb ? (
                          <img src={`/img/${t.thumb}`} alt={`${t.name} — last render`} loading="lazy" />
                        ) : (
                          <span class="tpl-blank" aria-hidden="true">
                            <span class="tpl-blank-name">{t.name}</span>
                          </span>
                        )}
                        <span class="tpl-meta">
                          <b>{t.name}</b>
                          <span class="mono faint">
                            {t.needs} slot{t.needs === 1 ? '' : 's'}
                            {!t.fits ? ' · needs shots this project can’t feed' : ''}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              ),
          )}
        </section>

        {currentTemplate && (
          <section class="ws card">
            <p class="kicker">
              <span class="g">/</span>Working on: <b>{currentTemplate.name}</b>
              {revisions.length > 0 && (
                <>
                  {' '}— {revisions.length} revision{revisions.length === 1 ? '' : 's'} ·{' '}
                  <a href={`/projects/${slug}/results?template=${currentTemplate.id}`}>Results →</a>
                </>
              )}
            </p>

            {currentRevision ? (
              <figure class="rev-card">
                <a href={`/img/${currentRevision.r2_key}`} target="_blank">
                  <img src={`/img/${currentRevision.r2_key}`} alt={currentRevision.format_name} />
                </a>
                <figcaption class="mono faint">
                  {currentRevision.format_slug} · {currentRevision.width}×{currentRevision.height}
                  {currentRevision.theme === 'dark' ? ' · dark' : ''}
                  <a class="btn small ghost" href={`/img/${currentRevision.r2_key}`} download={`${slug}-${currentRevision.format_slug}.png`}>
                    <Icon name="download" />Download
                  </a>
                  <a class="btn small ghost" href={`/projects/${slug}/preview?design=${currentRevision.id}`}>
                    <Icon name="watch" />In context
                  </a>
                  <a class="btn small ghost" href={`/projects/${slug}/design/editor?from=${currentTemplate.id}&design=${currentRevision.id}`}>
                    <Icon name="edit" />Editor
                  </a>
                </figcaption>
              </figure>
            ) : prospectiveErr ? (
              <p class="flash">{prospectiveErr}</p>
            ) : (
              <div class="schematic-wrap">
                <div class="schematic" style={`aspect-ratio: ${ogFormat.width} / ${ogFormat.height}`}>
                  {schematic.map((c) => (
                    <span class="sch-cell" style={`left:${c.x * 100}%;top:${c.y * 85}%;width:${c.w * 100}%;height:${c.h * 85}%`}>
                      {c.thumb && <img src={`/img/${c.thumb}`} alt="" loading="lazy" />}
                      <i>{c.label}</i>
                    </span>
                  ))}
                  <span class="sch-band mono">brand band</span>
                </div>
                <p class="mono faint">
                  schematic — the pictures Render will place. The real card (with your kit, words and
                  typography) is one click and $0.00.
                </p>
              </div>
            )}

            {currentRevision && slots.length > 0 && (
              <div class="slot-strip">
                <p class="ws-mini">Slots — the pictures in this revision; swap any one, the rest stay put</p>
                <div class="slot-row">
                  {slots.map((sl) => (
                    <span class="slot-tile">
                      {sl.thumb && <img src={`/img/${sl.thumb}`} alt="" loading="lazy" />}
                      <span class="mono faint">
                        {sl.position}. {sl.label ?? (sl.shot_position != null ? `shot ${sl.shot_position}` : 'upload')}
                      </span>
                      <span class="slot-actions">
                        {swapGroups.length > 0 && (
                          <button class="btn small ghost" type="button" data-swap-slot={sl.position}>
                            <Icon name="media" />Swap
                          </button>
                        )}
                        {sl.art_key && (
                          <a class="btn small ghost" href={`/img/${sl.art_key}`} download={`${slug}-${sl.label ?? `slot-${sl.position}`}-raw.png`}>
                            <Icon name="download" />Raw
                          </a>
                        )}
                      </span>
                    </span>
                  ))}
                </div>
              </div>
            )}

            <form method="post" class="words-form">
              <input type="hidden" name="action" value={currentRevision ? 'rerender' : 'render'} />
              {currentRevision ? (
                <input type="hidden" name="design" value={currentRevision.id} />
              ) : (
                <input type="hidden" name="template" value={currentTemplate.id} />
              )}
              <p class="ws-mini">Words — this revision's text (asterisks *accent* a word in the kit's accent color)</p>
              <div class="words-grid">
                <label class="field"><span>Title</span>
                  <input type="text" name="title" value={words.title} /></label>
                <label class="field"><span>Kicker (label above)</span>
                  <input type="text" name="kicker" value={words.kicker} /></label>
                <label class="field"><span>Tagline (line below)</span>
                  <input type="text" name="tagline" value={words.tagline} /></label>
              </div>
              <div class="render-row">
                {kitHasDark && (
                  <span class="theme-chips">
                    <a class:list={['chip', { on: scopeTheme === 'light' }]} href={tUrl({ theme: null })}>light</a>
                    <a class:list={['chip', { on: scopeTheme === 'dark' }]} href={tUrl({ theme: 'dark' })}>dark</a>
                  </span>
                )}
                <button class="btn" type="submit" data-running="Rendering…">
                  <Icon name="run" />{currentRevision ? 'Render · $0.00' : 'Render the first card · $0.00'}
                </button>
                <span class="mono faint">
                  {currentRevision
                    ? 'same words + pictures refreshes this card; any change makes a new revision beside it'
                    : `renders the ${ogFormat.slug} card with the slots above`}
                </span>
              </div>
            </form>

            {currentRevision && (
              <>
                <form method="post" class="revise-form">
                  <input type="hidden" name="action" value="revise" />
                  <input type="hidden" name="design" value={currentRevision.id} />
                  <input
                    type="text"
                    name="instruction"
                    placeholder="tell it what to change — e.g. move the text left, my picture a little right"
                  />
                  <button class="btn small" type="submit" data-running="Revising — ~20 seconds…">
                    <Icon name="cowrite" />Change it · under a cent
                  </button>
                </form>
                {currentTemplate.team_kind !== 'house' && (
                  <form method="post" class="save-template">
                    <input type="hidden" name="action" value="save-template" />
                    <input type="hidden" name="design" value={currentRevision.id} />
                    <input type="text" name="name" placeholder="save this template under a new name…" />
                    <button class="btn small ghost" type="submit"><Icon name="template" />Save</button>
                  </form>
                )}
              </>
            )}
          </section>
        )}

        {currentRevision && swapGroups.length > 0 && (
          <dialog id="swap-dialog">
            <form method="post" class="swap-form">
              <input type="hidden" name="action" value="set-panel" />
              <input type="hidden" name="design" value={currentRevision.id} />
              <input type="hidden" name="position" value="" id="swap-position" />
              <p class="kicker"><span class="g">/</span>Put another picture in slot <span id="swap-slot-no"></span></p>
              {swapGroups.map((g) => (
                <div class="swap-group">
                  <p class="ws-mini">{g.label}</p>
                  <div class="swap-grid">
                    {g.takes.map((t) => (
                      <button class="swap-take" type="submit" name="take" value={t.id} data-running="Rendering…">
                        {t.thumb && <img src={`/img/${t.thumb}`} alt="" loading="lazy" />}
                        <span class="mono faint">{t.model_alias} #{t.iteration}{t.picked ? ' · picked' : ''} · {t.style_name}</span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}
              <button class="btn small ghost swap-close" type="button" id="swap-cancel">Close</button>
            </form>
          </dialog>
        )}

        <form method="post" class="design-form card generate-form">
          <input type="hidden" name="action" value="generate" />
          <p class="inventory mono">Need more templates? Let the model propose arrangements — it writes configs, the renderer draws them.</p>
          <div class="form-grid">
            <label class="field">
              <span>Direction (optional) — <button type="button" class="linkish" id="brief-minimal">minimal</button> fills a quiet brief</span>
              <input type="text" name="brief" id="brief-input" placeholder="e.g. make the launch the hero, keep it calm" />
            </label>
            <label class="field" style="max-width:10rem">
              <span>How many</span>
              <select name="n">
                <option value="4">4</option>
                <option value="8">8</option>
                <option value="12">12</option>
                <option value="20" selected>20</option>
              </select>
            </label>
            <label class="field">
              <span>Format</span>
              <select name="format">
                {formats.results.map((f) => (
                  <option value={f.id}>{f.name} · {f.width}×{f.height}</option>
                ))}
              </select>
            </label>
          </div>
          <button class="btn ghost" type="submit" data-running="Designing — twenty seconds or so…"><Icon name="template" />Generate layouts · under a cent</button>
        </form>

        <p class="foot-note mono faint">
          {usableSlots} of {panels.length} shots feeding designs — manage visibility on
          <a href={`/projects/${slug}/shots`}> Shots &amp; takes</a> ·
          kit: {kitRow?.name ?? '?'} — <a href={`/projects/${slug}/settings`}>settings</a>
        </p>

        <script is:inline>
          document.getElementById('brief-minimal')?.addEventListener('click', () => {
            const b = document.getElementById('brief-input');
            b.value = 'minimal and quiet: one image or two at most, generous empty space, no shapes, at most one small text layer';
            b.focus();
          });
          // The swap picker — a modal is house-legal for pickers. The slot's
          // Swap button opens it and stamps the position into the form.
          (() => {
            const dlg = document.getElementById('swap-dialog');
            if (!dlg) return;
            document.querySelectorAll('[data-swap-slot]').forEach((b) => {
              b.addEventListener('click', () => {
                document.getElementById('swap-position').value = b.dataset.swapSlot;
                document.getElementById('swap-slot-no').textContent = b.dataset.swapSlot;
                dlg.showModal();
              });
            });
            document.getElementById('swap-cancel')?.addEventListener('click', () => dlg.close());
            dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
          })();
        </script>
      </>
    )
  }
</Base>

