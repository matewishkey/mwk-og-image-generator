---
import Base from '../../../layouts/Base.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import { ENV } from '../../../lib/runtime';
import { loadProject } from '../../../lib/data';
import { createRun, microsToUsd } from '../../../lib/runs';
import { sweepLeases } from '../../../lib/sweep';

const env = ENV;
const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const slug = Astro.params.slug!;
await sweepLeases(env);
const bundle = await loadProject(env, team.id, slug);
if (!bundle) return new Response('Not found', { status: 404 });

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action'));
  const takeId = String(form.get('take') ?? '');
  const nowIso = new Date().toISOString();

  const take = await env.DB.prepare(
    `SELECT t.id, t.shot_id, t.model_alias, t.status FROM take t
      JOIN run r ON r.id = t.run_id
     WHERE t.id = ?1 AND t.team_id = ?2 AND r.project_id = ?3`,
  )
    .bind(takeId, team.id, bundle.project.id)
    .first<{ id: string; shot_id: string; model_alias: string; status: string }>();

  if (take && action === 'pick' && take.status === 'succeeded') {
    // Repicking is one idempotent UPDATE — the Pick lives on the shot.
    await env.DB.prepare(`UPDATE shot SET picked_take_id = ?1, updated_at = ?2 WHERE id = ?3`)
      .bind(take.id, nowIso, take.shot_id)
      .run();
    return Astro.redirect(`/projects/${slug}/takes`);
  } else if (take && action === 'hide') {
    await env.DB.prepare(`UPDATE take SET hidden_at = ?1 WHERE id = ?2`).bind(nowIso, take.id).run();
    return Astro.redirect(`/projects/${slug}/takes`);
  } else if (take && action === 'unhide') {
    await env.DB.prepare(`UPDATE take SET hidden_at = NULL WHERE id = ?1`).bind(take.id).run();
    return Astro.redirect(`/projects/${slug}/takes`);
  } else if (take && action === 'reroll') {
    const shot = bundle.shots.find((s) => s.id === take.shot_id);
    if (shot) {
      try {
        await createRun(env, {
          teamId: team.id,
          userId: user.id,
          project: bundle.project,
          style: bundle.style,
          shots: [shot],
          models: [take.model_alias],
          iterations: 1,
          kind: 'take',
          supersedeTakeId: take.id,
        });
        return Astro.redirect(`/projects/${slug}/takes`);
      } catch (e) {
        error = `The re-roll could not start: ${(e as Error).message}`;
      }
    }
  }
}

interface TakeRow {
  id: string;
  shot_id: string;
  model_alias: string;
  tier: string;
  iteration: number;
  status: string;
  card_key: string | null;
  thumb_key: string | null;
  cost_micros: number;
  duration_ms: number | null;
  error_kind: string | null;
  error_message: string | null;
  created_at: string;
  hidden_at: string | null;
  picked: number;
  superseded: number;
}

const takes = await env.DB.prepare(
  `SELECT t.id, t.shot_id, t.model_alias, t.tier, t.iteration, t.status, t.card_key,
          t.thumb_key, t.cost_micros, t.duration_ms, t.error_kind, t.error_message,
          t.created_at, t.hidden_at,
          (t.id = sh.picked_take_id) AS picked,
          (t.superseded_by_id IS NOT NULL) AS superseded
     FROM take t JOIN run r ON r.id = t.run_id JOIN shot sh ON sh.id = t.shot_id
    WHERE r.project_id = ?1
    ORDER BY t.model_alias, t.iteration, superseded, t.created_at DESC`,
)
  .bind(bundle.project.id)
  .all<TakeRow>();

const spent = await env.DB.prepare(
  `SELECT coalesce(sum(c.usd_micros), 0) AS total FROM charge c
     JOIN run r ON r.id = c.run_id WHERE r.project_id = ?1`,
)
  .bind(bundle.project.id)
  .first<{ total: number }>();

const byShot = new Map<string, TakeRow[]>();
for (const t of takes.results) {
  byShot.set(t.shot_id, [...(byShot.get(t.shot_id) ?? []), t]);
}
const anyLive = takes.results.some((t) => ['queued', 'running', 'rendering'].includes(t.status));
const throttledSeen = takes.results.some((t) => t.error_kind === 'throttled');
const pickedCount = bundle.shots.filter((s) => s.picked_take_id).length;
---

<Base title={`${bundle.project.name} · takes`} nav="projects">
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>{bundle.project.name}</p>
    <h1>Contact sheet</h1>
    <p class="sub">
      Spent so far: <span class="money">{microsToUsd(spent?.total ?? 0)}</span> ·
      {pickedCount}/{bundle.shots.length} picked. A re-roll is a new take — the old one is
      never overwritten.
    </p>
  </div>

  <ProjectTabs slug={slug} active="takes" />

  {error && <p class="flash">{error}</p>}
  {
    throttledSeen && (
      <p class="flash">
        Replicate is throttling — this usually means the account balance is under $5, not a bug.
      </p>
    )
  }

  {
    bundle.shots.map((shot) => {
      const all = byShot.get(shot.id) ?? [];
      const visible = all.filter((t) => !t.hidden_at);
      const hidden = all.filter((t) => t.hidden_at);
      return (
        <section class="shot-sheet">
          <h2>
            <span class="mono shot-pos">{shot.position}</span> {shot.label ?? `Shot ${shot.position}`}
          </h2>
          {all.length === 0 && <p class="sub">No takes yet — run the project from Shots.</p>}
          <div class="takes-grid">
            {visible.map((t) => (
              <figure
                class={`take${t.picked ? ' picked' : ''}${t.superseded ? ' superseded' : ''}`}
                data-take={t.id}
                data-status={t.status}
                data-started={t.created_at}
              >
                {t.picked ? <span class="pick-chip">PICK</span> : null}
                {!t.picked && t.superseded ? <span class="old-chip">SUPERSEDED</span> : null}
                {t.status === 'succeeded' && t.card_key ? (
                  <a href={`/img/${t.card_key}`} target="_blank">
                    <img
                      src={`/img/${t.thumb_key ?? t.card_key}`}
                      alt={`${t.model_alias} take`}
                      loading="lazy"
                      width="640"
                      height="336"
                    />
                  </a>
                ) : (
                  <div class="take-hold">
                    <span class={`status ${t.status}`}>{t.status}</span>
                    {['queued', 'running', 'rendering'].includes(t.status) && (
                      <span class="mono elapsed" data-elapsed />
                    )}
                    {t.status === 'failed' && (
                      <span class="err">{t.error_kind}: {(t.error_message ?? '').slice(0, 160)}</span>
                    )}
                  </div>
                )}
                <figcaption>
                  <span class="mono">{t.model_alias}</span>
                  <span class="mono faint">#{t.iteration}</span>
                  {t.cost_micros > 0 && <span class="money">{microsToUsd(t.cost_micros)}</span>}
                  {t.duration_ms != null && <span class="mono faint">{Math.round(t.duration_ms / 1000)}s</span>}
                  {['succeeded', 'failed'].includes(t.status) && (
                    <span class="row-actions">
                      {t.status === 'succeeded' && !t.picked && (
                        <form method="post">
                          <input type="hidden" name="action" value="pick" />
                          <input type="hidden" name="take" value={t.id} />
                          <button class="btn small" type="submit">Pick</button>
                        </form>
                      )}
                      {!t.superseded && (
                        <form method="post">
                          <input type="hidden" name="action" value="reroll" />
                          <input type="hidden" name="take" value={t.id} />
                          <button class="btn small ghost" type="submit">Re-roll</button>
                        </form>
                      )}
                      {!t.picked && (
                        <form method="post">
                          <input type="hidden" name="action" value="hide" />
                          <input type="hidden" name="take" value={t.id} />
                          <button class="btn small ghost" type="submit">Hide</button>
                        </form>
                      )}
                    </span>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
          {hidden.length > 0 && (
            <details class="hidden-takes">
              <summary class="mono">{hidden.length} hidden</summary>
              <div class="takes-grid">
                {hidden.map((t) => (
                  <figure class="take dimmed">
                    {t.thumb_key && <img src={`/img/${t.thumb_key}`} alt="" loading="lazy" width="640" height="336" />}
                    <figcaption>
                      <span class="mono">{t.model_alias}</span>
                      <form method="post">
                        <input type="hidden" name="action" value="unhide" />
                        <input type="hidden" name="take" value={t.id} />
                        <button class="btn small ghost" type="submit">Unhide</button>
                      </form>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </details>
          )}
        </section>
      );
    })
  }
</Base>

<script is:inline define:vars={{ anyLive, slug }}>
  // Elapsed seconds are text that updates — the one deliberate carve-out from
  // "nothing on this site moves". A 64-second gpt2 wait behind a frozen label
  // reads as broken.
  const tick = () => {
    document.querySelectorAll('.take[data-started]').forEach((el) => {
      const live = ['queued', 'running', 'rendering'].includes(el.dataset.status);
      const out = el.querySelector('[data-elapsed]');
      if (live && out) {
        out.textContent = `${Math.max(0, Math.round((Date.now() - Date.parse(el.dataset.started)) / 1000))}s`;
      }
    });
  };
  tick();
  if (anyLive) {
    setInterval(tick, 1000);
    const poll = async () => {
      try {
        const res = await fetch(`/projects/${slug}/takes.json`);
        if (!res.ok) return;
        const takes = await res.json();
        for (const t of takes) {
          const el = document.querySelector(`.take[data-take="${t.id}"]`);
          if (el && el.dataset.status !== t.status) return location.reload();
        }
      } catch {}
    };
    setInterval(poll, 3000);
  }
</script>

<style>
  .shot-sheet { margin-bottom: 2.5rem; }
  .shot-sheet h2 { font-size: 1.2rem; margin-bottom: 0.8rem; }
  .shot-pos { color: var(--faint); }
  .takes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1rem; }
  .takes-grid > * { min-width: 0; }
  .take { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .take.picked { border-color: var(--red); }
  .take.superseded img { opacity: 0.55; }
  .old-chip {
    position: absolute; top: 10px; left: 10px; z-index: 2;
    font: 700 0.62rem/1 var(--font-mono); letter-spacing: 0.16em;
    background: var(--surface-2); color: var(--faint); border: 1px solid var(--line);
    padding: 0.3rem 0.45rem;
  }
  .pick-chip {
    position: absolute; top: 10px; left: 10px; z-index: 2;
    font: 700 0.62rem/1 var(--font-mono); letter-spacing: 0.16em;
    background: var(--red); color: var(--on-red); padding: 0.3rem 0.45rem;
  }
  .take img { display: block; width: 100%; height: auto; }
  .take.dimmed img { opacity: 0.45; }
  .take-hold {
    aspect-ratio: 1200 / 630; display: flex; flex-direction: column; gap: 0.5rem;
    align-items: center; justify-content: center; padding: 1rem; text-align: center;
  }
  .err { color: var(--mute); font-size: 0.78rem; }
  figcaption { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.7rem; font-size: 0.8rem; flex-wrap: wrap; }
  .faint { color: var(--faint); }
  .row-actions { margin-left: auto; display: flex; gap: 0.4rem; }
  .hidden-takes { margin-top: 0.8rem; }
  .hidden-takes summary { color: var(--faint); cursor: pointer; font-size: 0.78rem; }
  .hidden-takes .takes-grid { margin-top: 0.8rem; }
</style>
