---
import Base from '../../layouts/Base.astro';
import { ENV } from '../../lib/runtime';
import { createProject } from '../../lib/projects';
import { MODELS } from '../../../../src/models.ts';

const env = ENV;
const team = Astro.locals.team;
const user = Astro.locals.user!;
if (!team) return new Response('No team', { status: 403 });

const styles = await env.DB.prepare(
  `SELECT s.id, s.slug, s.name, s.description, t.kind AS team_kind
     FROM style s JOIN team t ON t.id = s.team_id
    WHERE (s.team_id = ?1 OR t.kind = 'house') AND s.archived_at IS NULL
    ORDER BY t.kind DESC, s.name`,
)
  .bind(team.id)
  .all<{ id: string; slug: string; name: string; description: string; team_kind: string }>();

const kits = await env.DB.prepare(
  `SELECT b.id, b.name, t.kind AS team_kind FROM brand_kit b JOIN team t ON t.id = b.team_id
    WHERE (b.team_id = ?1 OR t.kind = 'house') AND b.archived_at IS NULL
    ORDER BY t.kind DESC, b.name`,
)
  .bind(team.id)
  .all<{ id: string; name: string; team_kind: string }>();

const imageModels = MODELS.filter((m) => m.modality === 'image');
const DEFAULT_CHECKED = new Set(['zturbo', 'pimage']);

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const styleId = String(form.get('style') ?? '');
  if (!styles.results.some((s) => s.id === styleId)) error = 'Pick a style.';
  else {
    const result = await createProject(env, {
      teamId: team.id,
      userId: user.id,
      name: String(form.get('name') ?? ''),
      description: String(form.get('description') ?? ''),
      style: styleId,
      brandKit: String(form.get('brandkit') ?? '') || undefined,
      models: form.getAll('models').map(String),
      iterations: Number(form.get('iterations') ?? 1),
    });
    if ('slug' in result) return Astro.redirect(`/projects/${result.slug}/shots`);
    error = result.error;
  }
}
---

<Base title="New project" nav="projects">
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>New project</p>
    <h1>New project</h1>
    <p class="sub">One style, a set of models, and the shots you want. Start cheap — draft on the half-cent models, finish on gpt2.</p>
  </div>

  {error && <p class="flash">{error}</p>}

  <form method="post" class="new-project">
    <label class="field">
      <span>Name</span>
      <input type="text" name="name" required autofocus />
    </label>
    <label class="field">
      <span>Description</span>
      <input type="text" name="description" placeholder="optional" />
    </label>
    <fieldset class="field">
      <span>Style — the look every shot renders in (a shot can override it later)</span>
      <div class="style-grid">
        {styles.results.map((s) => (
          <label class="style-pick">
            <input type="radio" name="style" value={s.id} required />
            <span class="style-head">
              <b>{s.name}</b>
              {s.team_kind === 'house' && <em class="chip">house</em>}
            </span>
            <span class="style-desc">{s.description}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="field">
      <span>Models — draft cheap, finish on gpt2</span>
      <div class="model-grid">
        {imageModels.map((m) => (
          <label class="model-pick">
            <span class="model-row">
              <input type="checkbox" name="models" value={m.alias} checked={DEFAULT_CHECKED.has(m.alias)} />
              <span class="mono">{m.alias}</span>
              <span class="money">${m.priceUsd[m.tiers[0]!]}</span>
              {m.typicalSeconds && <span class="mono secs">~{m.typicalSeconds}s</span>}
            </span>
            <span class="model-name">{m.label}</span>
            {m.goodFor && <span class="model-good">+ {m.goodFor}</span>}
            {m.weakFor && <span class="model-weak">− {m.weakFor}</span>}
          </label>
        ))}
      </div>
    </fieldset>
    <div class="form-row">
      <label class="field" style="max-width:8rem">
        <span>Iterations</span>
        <input type="number" name="iterations" value="1" min="1" max="8" />
      </label>
      <label class="field" style="max-width:20rem">
        <span>Brand kit — <a href="/brand-kits">the library</a></span>
        <select name="brandkit">
          {kits.results.map((k) => (
            <option value={k.id}>{k.name} {k.team_kind === 'house' ? '· house' : ''}</option>
          ))}
        </select>
      </label>
    </div>
    <button class="btn" type="submit">Create project</button>
  </form>
</Base>

<style>
  .new-project { max-width: 62rem; }
  fieldset { border: 0; }
  .form-row { display: flex; gap: 1.5rem; flex-wrap: wrap; }

  .style-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 0.5rem; }
  .style-grid > * { min-width: 0; }
  .style-pick {
    display: grid; gap: 0.3rem; align-content: start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 0.65rem 0.8rem; cursor: pointer;
  }
  .style-pick:has(input:checked) { border-color: var(--accent); }
  .style-pick input { position: absolute; opacity: 0; }
  .style-head { display: flex; align-items: baseline; gap: 0.5rem; }
  .style-pick:has(input:checked) .style-head b { color: var(--accent); }
  .style-desc { color: var(--faint); font-size: 0.8rem; line-height: 1.35; }
  .chip {
    font: 700 0.6rem/1 var(--font-label); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mute); border: 1px solid var(--line); border-radius: 999px;
    padding: 0.15rem 0.45rem; font-style: normal;
  }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 0.5rem; }
  .model-grid > * { min-width: 0; }
  .model-pick {
    display: grid; gap: 0.25rem; align-content: start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 0.55rem 0.8rem; cursor: pointer;
  }
  .model-pick:has(input:checked) { border-color: var(--accent); }
  .model-row { display: flex; align-items: center; gap: 0.5rem; }
  .model-pick .mono { font-weight: 700; font-size: 0.85rem; }
  .model-pick .secs { font-weight: 400; color: var(--faint); font-size: 0.75rem; margin-left: auto; }
  .model-name { color: var(--faint); font-size: 0.78rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .model-good, .model-weak { font-size: 0.78rem; line-height: 1.35; }
  .model-good { color: var(--mute); }
  .model-weak { color: var(--faint); }
</style>
