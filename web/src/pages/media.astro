---
import Base from '../layouts/Base.astro';
import { ENV } from '../lib/runtime';
import { listLibrary, uploadReferences } from '../lib/media';

const env = ENV;
const team = Astro.locals.team;
if (!team) return new Response('No team', { status: 403 });

let error = '';
let note = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const files = form.getAll('photos').filter((f): f is File => f instanceof File && f.size > 0);
  const outcome = await uploadReferences(env, team.id, files);
  if (outcome.saved) note = `${outcome.saved} photo${outcome.saved === 1 ? '' : 's'} in the library.`;
  error = outcome.errors.join(' ');
}

const refs = await listLibrary(env, team.id);
---

<Base title="Media" nav="media">
  <div class="page-head">
    <p class="kicker"><span class="g">/</span>Library</p>
    <h1>Media</h1>
    <p class="sub">
      Reference photos, stored once per team and attachable to any project. The same
      photo uploaded twice lands in the same slot.
    </p>
  </div>

  {error && <p class="flash">{error}</p>}
  {note && <p class="flash">{note}</p>}

  <form method="post" enctype="multipart/form-data" class="card upload">
    <input type="file" name="photos" accept="image/png,image/jpeg,image/webp" multiple required />
    <button class="btn small" type="submit">Upload</button>
  </form>

  <div class="lib-grid">
    {
      refs.map((r) => (
        <figure class="lib-item">
          <a href={`/img/${r.r2_key}`} target="_blank">
            <img src={`/img/${r.r2_key}`} alt={r.filename} loading="lazy" />
          </a>
          <figcaption>
            <span class="fn">{r.filename}</span>
            <span class="mono faint">{r.width}×{r.height} · {r.uses} use{r.uses === 1 ? '' : 's'}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
  {refs.length === 0 && <p class="sub">Nothing yet.</p>}
</Base>

<style>
  .upload { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1.5rem; max-width: 40rem; }
  .upload input[type=file] { flex: 1; background: none; border: 0; color: var(--mute); font-size: 0.85rem; }
  .lib-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1rem; }
  .lib-grid > * { min-width: 0; }
  .lib-item img { width: 100%; height: 9rem; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); display: block; }
  .lib-item figcaption { display: grid; gap: 0.1rem; margin-top: 0.35rem; font-size: 0.78rem; }
  .fn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .faint { color: var(--faint); }
</style>
