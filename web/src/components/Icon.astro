---
/**
 * Inline icon — the set lives in icons.ts (shared with the workspace island).
 * Icons NEVER stand alone: every button keeps its text label. The /glossary
 * page lists every name with its meaning; add an icon → add its row there.
 */
import { ICON_PATHS, type IconName } from './icons';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  class="i"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICON_PATHS[name]}
/>
