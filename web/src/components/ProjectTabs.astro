---
interface Props {
  slug: string;
  active: 'shots' | 'takes';
}
const { slug, active } = Astro.props;
const tabs = [
  { id: 'shots', label: 'Shots' },
  { id: 'takes', label: 'Takes' },
] as const;
---

<nav class="ptabs">
  {
    tabs.map((t) => (
      <a href={`/projects/${slug}/${t.id}`} aria-current={active === t.id ? 'page' : undefined}>
        {t.label}
      </a>
    ))
  }
</nav>

<style>
  .ptabs {
    display: flex;
    gap: 1.2rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
    font: 700 0.9rem/1 var(--font-body);
  }
  .ptabs a {
    color: var(--mute);
    padding: 0.5rem 0.1rem 0.7rem;
    border-bottom: 2px solid transparent;
  }
  .ptabs a:hover { color: var(--ink); text-decoration: none; }
  .ptabs a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }
</style>
