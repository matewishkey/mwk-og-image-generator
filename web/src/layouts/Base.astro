---
import '../styles/tokens.css';
import '../styles/app.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  /** Which rail item is current, if any. */
  nav?: 'projects' | 'styles' | 'brand' | 'media' | 'models' | 'history' | 'team';
  /** When set, the rail shows this project's section under Projects. */
  project?: {
    slug: string;
    name: string;
    active: 'shots' | 'takes' | 'design' | 'preview' | 'settings';
  };
}
const { title, nav, project } = Astro.props;
const user = Astro.locals.user;

const NAV = [
  { id: 'projects', label: 'Projects', href: '/projects', icon: 'projects' },
  { id: 'styles', label: 'Styles', href: '/styles', icon: 'style' },
  { id: 'brand', label: 'Brand kits', href: '/brand-kits', icon: 'brand' },
  { id: 'media', label: 'Media', href: '/media', icon: 'media' },
  { id: 'models', label: 'Models', href: '/models', icon: 'model' },
  { id: 'history', label: 'History', href: '/history', icon: 'history' },
  { id: 'team', label: 'Team', href: '/team', icon: 'team' },
] as const;

const PROJECT_TABS = [
  { id: 'shots', label: 'Shots' },
  { id: 'takes', label: 'Takes' },
  { id: 'design', label: 'Design' },
  { id: 'preview', label: 'Preview' },
  { id: 'settings', label: 'Settings' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · MWK Studio</title>
    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.dataset.theme = t;
      else if (matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body class={user ? 'with-rail' : undefined}>
    {user && (
      <aside class="rail">
        <a class="brand" href="/projects">
          <span class="redblock" aria-hidden="true">
            <!-- brand/mwk-mark-white.svg, inlined -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="-6.75 -6.75 131.53 113.5" fill="none"><path d="M0 100 L23.09 0 L46.17 100 L69.26 0 L69.26 100" fill="none" stroke="currentColor" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M69.26 100 L118.03 0" fill="none" stroke="currentColor" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="wm">Mate <em>Wish</em> Key <span class="wm-app">Studio</span></span>
        </a>
        <nav class="rail-nav">
          {NAV.map((n) => (
            <Fragment>
              <a href={n.href} aria-current={nav === n.id ? 'page' : undefined}><Icon name={n.icon} />{n.label}</a>
              {n.id === 'projects' && project && (
                <div class="rail-proj">
                  <a class="rail-proj-name" href={`/projects/${project.slug}/shots`}>{project.name}</a>
                  {PROJECT_TABS.map((t) => (
                    <a
                      class="rail-sub"
                      href={`/projects/${project.slug}/${t.id}`}
                      aria-current={project.active === t.id ? 'page' : undefined}
                    >
                      {t.label}
                    </a>
                  ))}
                </div>
              )}
            </Fragment>
          ))}
        </nav>
        <div class="rail-foot">
          <button class="tt" id="theme-toggle" aria-label="Toggle theme" type="button">◐</button>
          <a class="tt" href="/glossary" title="Glossary — every icon and term">?</a>
          <span class="rail-user" title={user.email}>{user.email}</span>
          <form method="post" action="/auth/logout"><button class="linkish" type="submit">Out</button></form>
        </div>
      </aside>
    )}
    {!user && (
      <nav class="site-nav">
        <div class="nav-inner">
          <a class="brand" href="/">
            <span class="redblock" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="-6.75 -6.75 131.53 113.5" fill="none"><path d="M0 100 L23.09 0 L46.17 100 L69.26 0 L69.26 100" fill="none" stroke="currentColor" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M69.26 100 L118.03 0" fill="none" stroke="currentColor" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="wm">Mate <em>Wish</em> Key <span class="wm-app">Studio</span></span>
          </a>
          <div class="links">
            <button class="tt" id="theme-toggle" aria-label="Toggle theme" type="button">◐</button>
          </div>
        </div>
      </nav>
    )}
    <main class:list={['page-main', user ? 'rail-main' : 'wrap']}>
      <slot />
    </main>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
        el.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
    <script is:inline>
      // Hold-to-confirm — the house rule is NO popups. A button[data-confirm]
      // never submits from a click: the first click arms it (label → "sure?"),
      // and only a 1-second press-and-hold while armed fires the real submit.
      (() => {
        const HOLD_MS = 1000;
        const disarm = (b) => {
          clearTimeout(b._revert);
          clearTimeout(b._hold);
          b._hold = null;
          b._armed = false;
          b.classList.remove('arming', 'holding');
          if (b._html != null) b.innerHTML = b._html; // restore label + icon
        };
        const startHold = (b) => {
          if (b._hold) return;
          b.classList.add('holding');
          b._hold = setTimeout(() => {
            b.classList.remove('holding');
            b.form?.requestSubmit(b);
          }, HOLD_MS);
        };
        const cancelHold = (b) => {
          clearTimeout(b._hold);
          b._hold = null;
          b.classList.remove('holding');
        };
        const btnOf = (e) => (e.target instanceof Element ? e.target.closest('button[data-confirm]') : null);
        document.addEventListener('click', (e) => {
          const b = btnOf(e);
          if (!b) return;
          e.preventDefault();
          if (b._armed) return;
          b._armed = true;
          b._html = b.innerHTML;
          b.textContent = b.dataset.confirm || 'sure? hold';
          b.classList.add('arming');
          b._revert = setTimeout(() => disarm(b), 10000);
        });
        document.addEventListener('pointerdown', (e) => {
          const b = btnOf(e);
          if (b && b._armed) startHold(b);
        });
        for (const t of ['pointerup', 'pointerleave', 'pointercancel'])
          document.addEventListener(t, (e) => {
            const b = btnOf(e);
            if (b) cancelHold(b);
          }, true);
        document.addEventListener('keydown', (e) => {
          const b = btnOf(e);
          if (b && (e.key === 'Enter' || e.key === ' ')) {
            e.preventDefault();
            if (b._armed && !e.repeat) startHold(b);
          }
        });
        document.addEventListener('keyup', (e) => {
          const b = btnOf(e);
          if (b) cancelHold(b);
        });
      })();
    </script>
    <script is:inline>
      // Reference photos convert to JPEG in the browser before upload — every
      // model takes JPEG, it's ~4x smaller than a phone PNG, and EXIF drops for
      // free. An undecodable file passes through untouched; the server still
      // accepts PNG/WebP, so this is an optimisation, never a gate.
      document.querySelectorAll('input[type=file][data-jpeg]').forEach((inp) => {
        inp.addEventListener('change', async () => {
          const MAX = 2560;
          const dt = new DataTransfer();
          let changed = false;
          for (const f of inp.files) {
            try {
              const bmp = await createImageBitmap(f);
              const edge = Math.max(bmp.width, bmp.height);
              if (f.type === 'image/jpeg' && edge <= MAX) { dt.items.add(f); continue; }
              const scale = Math.min(1, MAX / edge);
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(bmp.width * scale);
              canvas.height = Math.round(bmp.height * scale);
              canvas.getContext('2d').drawImage(bmp, 0, 0, canvas.width, canvas.height);
              const blob = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', 0.9));
              if (!blob) throw new Error('encode failed');
              dt.items.add(new File([blob], f.name.replace(/\.[a-z4]+$/i, '') + '.jpg', { type: 'image/jpeg' }));
              changed = true;
            } catch {
              dt.items.add(f);
            }
          }
          if (changed) inp.files = dt.files;
        });
      });
    </script>
    <script is:inline>
      // Running state — anything that kicks background work shows it on the
      // button that started it. Disable on the NEXT tick so the submitter's
      // own name/value still posts with the form.
      document.addEventListener('submit', (e) => {
        const b = e.submitter;
        if (!(b instanceof HTMLButtonElement) || b.classList.contains('running')) return;
        const w = b.offsetWidth;
        setTimeout(() => {
          b.style.minWidth = `${w}px`;
          b.disabled = true;
          b.classList.remove('arming', 'holding');
          b.classList.add('running');
          b.textContent = b.dataset.running || 'Working…';
        });
      });
    </script>
  </body>
</html>
